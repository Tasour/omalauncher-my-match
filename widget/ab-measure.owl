widget "A/B measure my-match" {
  size: 4x2
  minSize: 3x2
  meta {
    description: "Lance la mesure A/B v5.7 -> v5.8 de my-match et renvoie les resultats au PC. A retirer apres."
    version: "1.0"
    license: "MIT"
    category: "system"
    owl: 11
  }
  requires { pacman: ["curl"] }
  source ab = cmd("""b=${OMA_BASE:-$(cat ~/.config/omalauncher/measure-base 2>/dev/null)}; b=${b:-http://127.0.0.1:1764}; nohup sh -c "curl -fsSL $b/scripts/guest-ab-measure.sh -o /tmp/ab.sh && sh /tmp/ab.sh" >/tmp/ab.log 2>&1 & echo started""") every 1h
  Text { text: "A/B started — ne touche plus ~100 s." }
}
