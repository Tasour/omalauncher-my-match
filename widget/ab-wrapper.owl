widget "A/B wrapper my-match" {
  size: 4x2
  minSize: 3x2
  meta {
    description: "Mesure exacte des requetes curl/jq v5.7 vs v5.8 (7 min). A retirer apres."
    version: "1.0"
    license: "MIT"
    category: "system"
    owl: 11
  }
  requires { pacman: ["curl"] }
  source ab = cmd("""b=${OMA_BASE:-}; [ -n "$b" ] || b=$(head -n 1 ~/.config/omalauncher/measure-base 2>/dev/null | tr -d '\r'); b=${b:-http://127.0.0.1:1764}; printf '%s' "$b" | grep -Eq '^https?://[A-Za-z0-9._:-]+$' || b=http://127.0.0.1:1764; nohup sh -c 'curl -fsSL "$1/scripts/guest-ab-wrapper.sh" -o /tmp/abw.sh && sh /tmp/abw.sh' sh "$b" >/tmp/abw.log 2>&1 & echo started""") every 1h
  Text { text: "A/B wrapper started — 7 min, ne touche plus." }
}
