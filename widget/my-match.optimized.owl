    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    LEAGUES="uefa.champions uefa.europa uefa.europa.conf"
    tagof() {
      if [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      if r=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 1 --retry-delay 0 --retry-max-time 20 --retry-connrefused -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null) && [ -n "$r" ]; then
        printf '%s' "$r" | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" '($want | split(",") | map(select(. != ""))) as $wl | def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .season.slug as $round | .competitions[0] as $c | {id: ($lg + ":" + (.id | tostring)), league: $lg, tag: $tag, stage: $round, at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, squads: ([$c.competitors[] | .team.abbreviation]), home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T), aggH: (($c.competitors[] | select(.homeAway == "home") | (.team.id | tostring)) as $hid | ([$c.series.competitors[]? | select(.id == $hid) | .aggregateScore] | .[0] // null)), aggA: (($c.competitors[] | select(.homeAway == "away") | (.team.id | tostring)) as $aid | ([$c.series.competitors[]? | select(.id == $aid) | .aggregateScore] | .[0] // null)), aggDone: ($c.series.completed // false)}' > "$tmp/$lg-$d.jsonl" && echo ok >> "$tmp/ok.log"
      fi
    }
    n=0
    run() {
      fetch "$1" "$2" &
      n=$((n + 1))
      if [ "$n" -ge 10 ]; then wait; n=0; fi
    }
    Y=$(date +%Y)
    M=$(date +%-m)
    if [ "$M" -ge 8 ]; then S=$Y; else S=$((Y - 1)); fi
    E=$((S + 1))
    for lg in $LEAGUES; do
      for m in "$E"02 "$E"03 "$E"04 "$E"05; do
        run "$lg" "$m"
      done
    done
    wait
    # Au moins une reponse valide exigee (sinon echec) ; zero evenement
    # est un succes normal hors saison (l'arbre s'affichera plus tard).
    [ -s "$tmp/ok.log" ] || exit 1
    cat "$tmp"/*.jsonl 2>/dev/null | jq -cs 'unique_by(.id) | sort_by(.at)' > "$tmp/knock.json" 2>/dev/null || echo '[]' > "$tmp/knock.json"
    # Fusion anti-trous : le frais gagne par id, le cache comble les tours
    # absents ; on ne garde que la saison en cours (pas l'arbre precedent).
    keep=$(date -d "$S-09-01" +%s)
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-knock.json
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then cmark "$cache" 604800; fi
    OLD="$cache"
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then OLD=/dev/null; fi
    jq -cs --argjson keep "$keep" '.[1] as $old | (.[0] // []) as $fu | ([$fu[] | .id] | unique) as $fresh | ($fu + ([($old // [])[]] | map(.id as $id | select($id != null and (.at // 0) >= $keep and ($fresh | index($id)) == null)))) | unique_by(.id) | sort_by(.at)' "$tmp/knock.json" "$OLD" > "$tmp/merged.json" 2>/dev/null || printf '[]' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/knock.json" 2>/dev/null || echo 0)
    if [ "$(jq 'length // 0' "$tmp/merged.json")" -gt 0 ]; then
      cp "$tmp/merged.json" "$cache.tmp" && mv "$cache.tmp" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 604800
      cp "$tmp/merged.json" "$tmp/knock.json"
    elif cvalid "$cache" && ! cstale "$cache" 604800 && [ -s "$cache" ] && [ "$(jq 'length // 0' "$cache" 2>/dev/null || printf 0)" -gt 0 ]; then
      cp "$cache" "$tmp/knock.json"
    fi
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    B=~/.cache/espn-logos/banner
    mkdir -p "$B"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    n=0
    for f in $(jq -r '.[].home.logo, .[].away.logo | select(. != null and . != "")' "$tmp/knock.json" | sort -u); do
      if [ ! -s "$d/$f" ]; then
        p=$(echo "$f" | tr '-' '/')
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"; [ -s "$d/$f" ] && [ ! -s "$B/$f" ] && cp "$d/$f" "$B/$f"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    cat "$tmp/knock.json"
    rm -rf "$tmp"
