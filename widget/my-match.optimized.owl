      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      if r=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 0 -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null) && [ -n "$r" ]; then
        printf '%s' "$r" | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" '($want | split(",") | map(select(. != ""))) as $wl | def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .competitions[0] as $c | select($c.status.type.state == "pre") | {id: ($lg + ":" + (.id | tostring)), league: $lg, tag: $tag, stage: (.season.slug // ""), at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, squads: ([$c.competitors[] | .team.abbreviation]), home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T)}' > "$tmp/$lg-$d.jsonl" && echo ok >> "$tmp/ok.log"
      fi
    }
    n=0
    run() {
      fetch "$1" "$2" > "$tmp/$1-$2.jsonl" &
      n=$((n + 1))
      if [ "$n" -ge 5 ]; then wait; n=0; sleep 1; fi
    }
    # Mois courant inclus (sinon la journee en cours, ex. J3 C1 du mois en
    # cours, est sautee) + 3 mois suivants.
    MONTHS=$(for off in 0 30 60 90; do date -d "$off day" +%Y%m; done | sort -u)
    for lg in $LEAGUES; do
      for m in $MONTHS; do
        run "$lg" "$m"
      done
    done
    wait
    [ -s "$tmp/ok.log" ] || exit 1
    cat "$tmp"/*.jsonl 2>/dev/null | jq -cs 'unique_by(.id) | group_by(.league) | map(if (.[0].league == "uefa.champions" or .[0].league == "uefa.europa" or .[0].league == "uefa.europa.conf") then (sort_by(.at) | .[0:18]) else (sort_by(.at) | .[0:8]) end) | add // []' > "$tmp/next.json" 2>/dev/null || echo '[]' > "$tmp/next.json"
    # Fusion anti-trous : le frais gagne par id, le cache comble les ligues
    # absentes ; on purge les affiches passees de plus d'un jour (jouees).
    now=$(date +%s)
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-nextup.json
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then cmark "$cache" 86400; fi
    OLD="$cache"
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then OLD=/dev/null; fi
    jq -cs --argjson cut "$((now - 86400))" '.[1] as $old | (.[0] // []) as $fu | ([$fu[] | .id] | unique) as $fresh | ($fu + ([($old // [])[]] | map(.id as $id | select($id != null and (.at // 0) > $cut and ($fresh | index($id)) == null)))) | unique_by(.id) | sort_by(.at)' "$tmp/next.json" "$OLD" > "$tmp/merged.json" 2>/dev/null || printf '[]' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/next.json" 2>/dev/null || echo 0)
    if [ "$(jq 'length // 0' "$tmp/merged.json")" -gt 0 ]; then
      cp "$tmp/merged.json" "$cache.tmp" && mv "$cache.tmp" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 86400
      cp "$tmp/merged.json" "$tmp/next.json"
    elif cvalid "$cache" && ! cstale "$cache" && [ -s "$cache" ] && [ "$(jq 'length // 0' "$cache" 2>/dev/null || printf 0)" -gt 0 ]; then
      jq -c --argjson cut "$((now - 86400))" 'map(select((.at // 0) > $cut))' "$cache" > "$tmp/next.json"
    fi
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    B=~/.cache/espn-logos/banner
    mkdir -p "$B"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    n=0
    for f in $(jq -r '.[].home.logo, .[].away.logo | select(. != null and . != "")' "$tmp/next.json" | sort -u); do
      if [ ! -s "$d/$f" ]; then
        p=$(echo "$f" | tr '-' '/')
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"; [ -s "$d/$f" ] && [ ! -s "$B/$f" ] && cp "$d/$f" "$B/$f"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    cat "$tmp/next.json"
    rm -rf "$tmp"
  """)every 12h json timeout 360s status
source histfull=cmd("""
    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    WANTLG="""+sh(favLg)+""";
    ALLLG="fra.1 fra.2 ned.1 por.1 tur.1 bel.1 sco.1 gre.1 sui.1 aut.1 den.1 nor.1 swe.1 rou.1 cze.1 isr.1 cyp.1 uefa.europa uefa.europa.conf uefa.nations fifa.worldq.uefa fifa.friendly eng.1 esp.1 ger.1 ita.1 uefa.champions fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia"
    RR="fra.1 fra.2 fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia eng.1 esp.1 ger.1 ita.1 uefa.champions uefa.europa uefa.europa.conf"
    for l in $(printf '%s' "$WANTLG" | tr ',' ' '); do
      case " $ALLLG " in *" $l "*) case " $RR " in *" $l "*) ;; *) RR="$RR $l";; esac;; esac
    done
    tagof() {
      if [ "$1" = "fra.1" ]; then printf 'L1'
      elif [ "$1" = "fra.2" ]; then printf 'L2'
      elif [ "$1" = "fra.coupe_de_france" ]; then printf 'CDF'
      elif [ "$1" = "eng.fa" ]; then printf 'FA'
      elif [ "$1" = "eng.league_cup" ]; then printf 'LC'
      elif [ "$1" = "esp.copa_del_rey" ]; then printf 'CDR'
      elif [ "$1" = "ger.dfb_pokal" ]; then printf 'DFB'
      elif [ "$1" = "ita.coppa_italia" ]; then printf 'CI' 
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      elif [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.nations" ]; then printf 'NAT'
      elif [ "$1" = "fifa.worldq.uefa" ]; then printf 'QCM'
      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
      elif [ "$1" = "eng.1" ]; then printf 'ENG'
      elif [ "$1" = "esp.1" ]; then printf 'ESP'
      elif [ "$1" = "ger.1" ]; then printf 'GER'
      elif [ "$1" = "ita.1" ]; then printf 'ITA'
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      r=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 1 --retry-delay 0 --retry-max-time 20 --retry-connrefused -fsm 15 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null) || return 1
      printf '%s' "$r" | jq -e 'type == "object" and (has("events") or has("leagues"))' >/dev/null 2>&1 || return 1
      printf '%s' "$r" | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" '($want | split(",") | map(select(. != ""))) as $wl | def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .competitions[0] as $c | {id: ($lg + ":" + (.id | tostring)), league: $lg, tag: $tag, stage: (.season.slug // ""), at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, squads: ([$c.competitors[] | .team.abbreviation]), home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T)}'
    }
    n=0
    run() {
      fetch "$1" "$2" | jq -c --arg m "$2" '. + {month: $m}' > "$tmp/$1-$2.jsonl" &
      n=$((n + 1))
      if [ "$n" -ge 10 ]; then wait; n=0; fi
    }
    Y=$(date +%Y)
    M=$(date +%-m)
    if [ "$M" -ge 8 ]; then S=$Y; else S=$((Y - 1)); fi
    E=$((S + 1))
    SEASON=""
    for m in 08 09 10 11 12; do SEASON="$SEASON $S$m"; done
    for m in 01 02 03 04 05 06 07; do SEASON="$SEASON $E$m"; done
    # Mois passes deja en cache : immuables, on ne refetch que courant + futur.
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-hist-base.json
    CUR=$(date +%Y%m)
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e '.lms and .items' "$cache" >/dev/null 2>&1; then cmark "$cache" 2592000; fi
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e '.lms and .items' "$cache" >/dev/null 2>&1; then printf '{"lms":[],"items":[]}' > "$cache.tmp" && mv "$cache.tmp" "$cache"; cmark "$cache" 2592000; fi
    for lg in $RR; do
      for m in $SEASON; do
        if [ "$m" -ge "$CUR" ] || ! jq -e --arg k "$lg:$m" '.lms | index($k) != null' "$cache" >/dev/null 2>&1; then
          run "$lg" "$m"
        fi
      done
    done
    wait
    cat "$tmp"/*.jsonl 2>/dev/null | jq -cs 'unique_by(.id)' > "$tmp/fresh.json"
    # Cache mensuel comme seasonAll : passe immuable servi depuis le cache.
    jq -c --slurpfile fr "$tmp/fresh.json" --arg cur "$CUR" --arg keep "$S"08 '
      ($fr[0] // []) as $fresh
      | (.lms // []) as $lms | (.items // []) as $old
      | ([$fresh[] | select(.id != null)] | unique_by(.id)) as $fu
      | ([$fu[] | ((.league // "") + ":" + (.month // ""))] | unique) as $flms
      | ([$old[] | select(.id != null and ((.league // "") + ":" + (.month // "")) as $lm | ($flms | index($lm)) == null)] | unique_by(.id)) as $kept
      | ((($fu + $kept) | unique_by(.id)) | map(select((.month // "0") >= $keep))) as $items
      | {cache: {lms: (($lms + ($flms | map(select((split(":")[1] // "0") < $cur)))) | unique | map(select((split(":")[1] // "0") >= $keep))), items: $items}, out: ($items | sort_by(.at))}
    ' "$cache" > "$tmp/merged.json" 2>/dev/null || printf '{"out":[]}' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/fresh.json" 2>/dev/null || echo 0)
    if [ "$(jq '.out | length // 0' "$tmp/merged.json" 2>/dev/null || printf 0)" -gt 0 ]; then
      jq -c '.cache' "$tmp/merged.json" > "$tmp/cache.json" && mv "$tmp/cache.json" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 2592000
      jq -c '.out' "$tmp/merged.json" > "$tmp/baseraw.json"
    elif cvalid ~/.cache/espn-history.json && ! cstale ~/.cache/espn-history.json 2592000 && [ -s ~/.cache/espn-history.json ]; then
      cat ~/.cache/espn-history.json
      rm -rf "$tmp"
      exit 0
    else
      rm -rf "$tmp"
      exit 1
    fi
    jq -c 'unique_by(.id)' "$tmp/baseraw.json" > "$tmp/base.json"
    [ "$(jq 'length // 0' "$tmp/base.json")" -gt 0 ] || exit 1
    # Journees championnats : passes calibres sur le classement (n =
    # journee en cours, les K plus recents = Jn, etc.), a venir en Jn+1,
    # Jn+2... par paquets de K dans l'ordre chronologique. Exact hors reports.
    # Journees coupes d'Europe (phase de ligue) : une journee = les matchs
    # d'une meme semaine. Grappes chronologiques (trou > 4 j = nouvelle
    # journee), sans classement : insensible aux reports et aux trous de
    # fetch. Seule la phase de ligue est numerotee (le knockout garde son
    # stage via knock).
    n=0
    rrun() {
      lg=$1
      if [ "$lg" = "uefa.champions" ] || [ "$lg" = "uefa.europa" ] || [ "$lg" = "uefa.europa.conf" ]; then
        jq -c --arg lg "$lg" '[(.[] | select(.league == $lg and ((.stage // "league-phase") == "league-phase")))] | sort_by(.at) | reduce .[] as $m ({p: 0, n: 0, r: []}; ($m.at // 0) as $t | if .n == 0 then {p: $t, n: 1, r: [{id: $m.id, round: 1}]} elif ($t - .p) > 345600 then {p: $t, n: (.n + 1), r: (.r + [{id: $m.id, round: (.n + 1)}])} else {p: .p, n: .n, r: (.r + [{id: $m.id, round: .n}])} end) | .r[] | select(.round > 0)' "$tmp/base.json" > "$tmp/rounds-$lg.json" &
        n=$((n + 1))
        if [ "$n" -ge 6 ]; then wait; n=0; fi
        return
      fi
      if [ "$lg" = "fra.1" ] || [ "$lg" = "fra.2" ] || [ "$lg" = "ger.1" ]; then k=9; elif [ "$lg" = "uefa.champions" ]; then k=18; else k=10; fi
      nn=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 2 --retry-delay 0 --retry-max-time 30 --retry-connrefused -fsm 15 --compressed "https://site.api.espn.com/apis/v2/sports/soccer/$lg/standings" 2>/dev/null | jq '[.children[].standings.entries[] | select(.stats != null) | (.stats | map(select(.name == "gamesPlayed"))[0].value // 0 | floor)] | group_by(.) | max_by(length) | .[0] // 0')
      [ "$nn" = "" ] && nn=0
      if [ "$nn" -gt 0 ] 2>/dev/null; then
        jq -c --arg lg "$lg" --argjson k "$k" --argjson n "$nn" '[.[] | select(.league == $lg)] as $all | ([$all[] | select(.state != "pre")] | sort_by(.at)) as $past | ([$all[] | select(.state == "pre")] | sort_by(.at)) as $fut | ($past | length) as $lp | ([$past | to_entries[] | {id: .value.id, round: ($n - ((($lp - 1 - .key) / $k) | floor))}] + [$fut | to_entries[] | {id: .value.id, round: ($n + 1 + ((.key / $k) | floor))}]) | map(select(.round > 0)) | .[]' "$tmp/base.json" > "$tmp/rounds-$lg.json"
      else
        : > "$tmp/rounds-$lg.json"
      fi &
      n=$((n + 1))
      if [ "$n" -ge 6 ]; then wait; n=0; fi
    }
    for lg in $RR; do
      rrun "$lg"
    done
    wait
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    B=~/.cache/espn-logos/banner
    mkdir -p "$B"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    n=0
    for f in $(jq -r '.[].home.logo, .[].away.logo | select(. != null and . != "")' "$tmp/base.json" | sort -u); do
      if [ ! -s "$d/$f" ]; then
        p=$(echo "$f" | tr '-' '/')
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"; [ -s "$d/$f" ] && [ ! -s "$B/$f" ] && cp "$d/$f" "$B/$f"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    jq -sc 'map(select(.round != null and .round > 0)) | map({(.id): .round}) | add // {}' "$tmp"/rounds-*.json > "$tmp/roundmap.json"
    jq -cs '.[1] as $r | .[0] | map(. + {round: ($r[.id] // null)}) | sort_by(.league) | group_by(.league) | map({key: .[0].league, value: (sort_by(.at) | reverse)}) | from_entries' "$tmp/base.json" "$tmp/roundmap.json" > "$tmp/hist.json"
    if [ "$(jq 'keys | length' "$tmp/hist.json")" -gt 0 ]; then
      cp "$tmp/hist.json" ~/.cache/espn-history.json.tmp && mv ~/.cache/espn-history.json.tmp ~/.cache/espn-history.json
      [ "$FRESH" -gt 0 ] && cmark ~/.cache/espn-history.json 2592000
    elif cvalid ~/.cache/espn-history.json && ! cstale ~/.cache/espn-history.json 2592000 && [ -s ~/.cache/espn-history.json ]; then
      cat ~/.cache/espn-history.json
      rm -rf "$tmp"
      exit 0
    else
      rm -rf "$tmp"
      exit 1
    fi
    cat "$tmp/hist.json"
    rm -rf "$tmp"
  """)every 24h json timeout 300s status
source slow=clock every 1h
source spr=file("~/.cache/espn-logos/sprite.json")json
state lang=startsWith(lower(lang()),"fr")?"fr":"en"persist
let S=lang=="fr"?{tabMine:"Mes matchs",tabRiv:"Rivaux",tabTop5:"Top 5",tabEurope:"Europe",loading:"chargement…",close:"fermer",settings:"réglages",hide:"masquer",refreshing:"actualisation… ",failP:"✗ échec · ",fail:"Scores peut-être en retard",postponed:"reporté",cancelled:"annulé",suspended:"suspendu",degraded:"données dégradées",health:"État des sources",sourceErr:"Source indisponible",about:"À propos",dataBy:"données ESPN — non affilié",clearCaches:"effacer les caches",clearAsk:"supprimer les caches ESPN ?",yes:"oui",no:"non",lead:"Rappel T−",matchday:"Jour de match",compact:"Compact",todayOnly:"Aujourd'hui",showOdds:"Cotes",showForm:"Forme",copyMatch:"Copier le match",copyTeams:"Copier les équipes",detail:"Fiche",recent:"derniers résultats",rivalsT:"Rivaux explicites",rivalsHint:"Codes séparés par des virgules (PSG, OM…)",alertsByClub:"Alertes par club",teamColors:"Couleurs par équipe",leadersT:"leaders",injuriesT:"blessures / suspendus",archiveT:"Archive",exportT:"Exporter l'archive",travel:"Copier le travel pack",travelP:"heure locale · prépare ton déplacement",lowData:"Mode basse data",offline:"Hors ligne",banter:"Chambrage",importT:"Importer la config",importHint:"colle le JSON de mes équipes",importOk:"config importée",localTime:"heure locale",preview:"Avant-match",overview:"Aperçu",oddsTab:"Cotes",statsTab:"Stats",h2hTab:"H2H",squadTab:"Onze",newsTab:"Actus",travelTab:"Voyage",keysT:"Clés du match",contextT:"Contexte",last5T:"5 derniers",next5T:"5 prochains",recordT:"Bilan",goalsT:"Buts",cleanT:"Clean sheets",bttsT:"BTTS",overT:"+2,5",ppgT:"PPG",projT:"Projection",restT:"Repos",importanceT:"Enjeu",formHomeT:"Forme dom.",formAwayT:"Forme ext.",formHomeShort:"Dom.",formAwayShort:"Ext.",venue:"Stade",referee:"Arbitre",alerts:"Alertes",noDataT:"pas encore de données",previewHint:"cotes indicatives · aucune mise",copyPreviewT:"Copier",rankT:"Rang",totalT:"Total buts",handicapT:"Handicap",compareT:"Comparaison",pts5T:"Pts (5)",momentumT:"Momentum",avgRankT:"Rang