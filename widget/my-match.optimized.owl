widget"My Matches – Football"{
size:6x4
minSize:5x4
meta{description:"Live football scores, standings and fixtures for your favourite clubs and national teams — matchday browsing, rivals, Europe tabs, Top-5 leagues, odds and match reminders (ESPN).";version:"5.16.2";license:"MIT";category:"sport";owl:16}
requires{pacman:["curl","jq","perl"]}
let favStr=join(myTeams.map(t=>(t.abbr??"")).filter(a=>a!=""&&!contains(a,",")&&!contains(a,"\n")&&!contains(a,"\r")).take(5),",")
let favTid=join(myTeams.map(t=>(t.tid??"")).filter(a=>a!=""&&!contains(a,",")&&!contains(a,"\n")&&!contains(a,"\r")).take(5),",")
let favNoTid=join(myTeams.map(t=>(t.tid??"")==""?(t.abbr??""):"").filter(a=>a!=""&&!contains(a,",")&&!contains(a,"\n")&&!contains(a,"\r")).take(5),",")
let favLg=count(myTeams)>0?join(unique(flatten(myTeams.map(t=>flatten([(teamsDb.out??[]).filter(d=>d.key==(t.key??((t.abbr??"")+":"+(t.kind??"c")))).map(d=>d.leagues??[]).first??[],t.leagues??[],[t.league]])))).filter(l=>l!=null&&l!=""&&!contains(l,",")&&!contains(l,"\n")&&!contains(l,"\r")),","):""
let gamesScript="""    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    WANT="""+sh(favStr)+""";
    WANTID="""+sh(favTid)+""";
    WANTNOTID="""+sh(favNoTid)+""";
    WANTLG="""+sh(favLg)+""";
    if [ -z "$WANT" ] && [ -z "$WANTID" ]; then printf '[]'; rm -rf "$tmp"; exit 0; fi
    LG=$(printf '%s' "$WANTLG" | tr ',' ' ')
    if [ -z "$LG" ]; then
      # fallback : etat persiste ancien sans league, on garde le comportement complet
      CLUBS="fra.1 fra.2 fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia ned.1 por.1 tur.1 bel.1 sco.1 gre.1 sui.1 aut.1 den.1 nor.1 swe.1 rou.1 cze.1 isr.1 cyp.1 uefa.europa uefa.europa.conf eng.1 esp.1 ger.1 ita.1 uefa.champions"
      NATS="uefa.nations fifa.worldq.uefa fifa.friendly"
    else
      NONNAT=$(printf '%s\n' $LG | grep -Ev '^(uefa\.nations|fifa\.(worldq\.uefa|friendly))$' || true)
      if [ -n "$NONNAT" ]; then
        CLUBS=$(printf '%s\n' $NONNAT uefa.champions uefa.europa uefa.europa.conf | awk 'NF && !seen[$0]++' | tr '\n' ' ')
        case " $NONNAT " in *" fra.1 "*|*" fra.2 "*) CLUBS="$CLUBS fra.coupe_de_france";; esac
        case " $NONNAT " in *" eng.1 "*) CLUBS="$CLUBS eng.fa eng.league_cup";; esac
        case " $NONNAT " in *" esp.1 "*) CLUBS="$CLUBS esp.copa_del_rey";; esac
        case " $NONNAT " in *" ger.1 "*) CLUBS="$CLUBS ger.dfb_pokal";; esac
        case " $NONNAT " in *" ita.1 "*) CLUBS="$CLUBS ita.coppa_italia";; esac
      else
        CLUBS=""
      fi
      NATS=""
      case " $LG " in
        *" uefa.nations "*|*" fifa.worldq.uefa "*|*" fifa.friendly "*)
          NATS=$(printf '%s\n' $LG uefa.nations fifa.worldq.uefa fifa.friendly | awk 'NF && !seen[$0]++' | tr '\n' ' ') ;;
      esac
    fi
    tagof() {
      if [ "$1" = "fra.1" ]; then printf 'L1'
      elif [ "$1" = "fra.2" ]; then printf 'L2'
      elif [ "$1" = "fra.coupe_de_france" ]; then printf 'CDF'
      elif [ "$1" = "eng.fa" ]; then printf 'FA'
      elif [ "$1" = "eng.league_cup" ]; then printf 'LC'
      elif [ "$1" = "esp.copa_del_rey" ]; then printf 'CDR'
      elif [ "$1" = "ger.dfb_pokal" ]; then printf 'DFB'
      elif [ "$1" = "ita.coppa_italia" ]; then printf 'CI' 
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      elif [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.nations" ]; then printf 'NAT'
      elif [ "$1" = "fifa.worldq.uefa" ]; then printf 'QCM'
      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      r=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 1 --retry-delay 0 --retry-max-time 20 --retry-connrefused -fsm 15 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null) || return 1
      printf '%s' "$r" | jq -e 'type == "object" and (has("events") or has("leagues"))' >/dev/null 2>&1 || return 1
      printf '%s' "$r" | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" --arg wantid "$WANTID" --arg wantnotid "$WANTNOTID" '($want | split(",") | map(select(. != ""))) as $wl | ($wantid | split(",") | map(select(. != ""))) as $wlid | ($wantnotid | split(",") | map(select(. != ""))) as $wln | def dec: ((tostring) | if startswith("+") then .[1:] else . end | (try tonumber catch null)) as $n | if $n == null or $n == 0 then null elif $n > 0 then 1 + ($n / 100) else 1 + (100 / (0 - $n)) end; def O: ([.odds[]? | select(. != null and .moneyline != null)][0]) as $o | if $o == null then null else {h: (($o.moneyline.home.close.odds // $o.moneyline.home.open.odds // $o.homeTeamOdds.moneyLine // null) | dec), d: (($o.moneyline.draw.close.odds // $o.moneyline.draw.open.odds // $o.drawOdds.moneyLine // null) | dec), a: (($o.moneyline.away.close.odds // $o.moneyline.away.open.odds // $o.awayTeamOdds.moneyLine // null) | dec), ho: (($o.moneyline.home.open.odds // null) | dec), do: (($o.moneyline.draw.open.odds // null) | dec), ao: (($o.moneyline.away.open.odds // null) | dec), tot: (($o.total.over.close.line // "") | sub("^[ou]";"") | (try tonumber catch null)), tov: ($o.total.over.close.odds | dec), tun: (($o.total.under.close.line // "") | sub("^[ou]";"") | (try tonumber catch null)), tuv: ($o.total.under.close.odds | dec), sph: (($o.pointSpread.home.close.line // "") | (try tonumber catch null)), sphv: ($o.pointSpread.home.close.odds | dec), spa: (($o.pointSpread.away.close.line // "") | (try tonumber catch null)), spav: ($o.pointSpread.away.close.odds | dec)} end; def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .competitions[0] as $c | {ids: [$c.competitors[]? | .team.id | tostring], abbrs: [$c.competitors[]? | .team.abbreviation]} as $duo | select((($wlid | length) > 0 and ([$duo.ids[] | IN($wlid[])] | any)) or (($wln | length) > 0 and ([$duo.abbrs[] | IN($wln[])] | any)) or ((($wlid | length) == 0 and ($wln | length) == 0) and ([$duo.abbrs[] | IN($wl[])] | any))) | {id: ($lg + ":" + .id), league: $lg, tag: $tag, at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, stage: (.season.slug // ""), squads: ([$c.competitors[] | .team.abbreviation]), tids: $duo.ids, odds: ($c | O), teams: [$c.competitors[] | {side: .homeAway} + T], home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T)}'
    }
    # Cache mensuel range par signature de suivi : les mois passes sont immuables.
    SIG=$(printf '%s|%s|%s|%s' "$WANT" "$WANTID" "$WANTNOTID" "$WANTLG" | sha256sum | cut -d' ' -f1)
    MC=~/.cache/espn-games-months/$SIG
    mkdir -p "$MC"
    CUR=$(date +%Y%m)
    NOW=$(date +%s)
    n=0
    run() {
      ( f="$tmp/$1-$2.jsonl"
        if fetch "$1" "$2" > "$f.tmp"; then
          mv "$f.tmp" "$f"
          cp "$f" "$MC/$1-$2.jsonl.tmp" && mv "$MC/$1-$2.jsonl.tmp" "$MC/$1-$2.jsonl"
          : > "$MC/$1-$2.jsonl.ok"
        else
          rm -f "$f.tmp"
        fi ) &
      n=$((n + 1))
      if [ "$n" -ge 8 ]; then wait; n=0; sleep 1; fi
    }
    MONTHS=$(for off in -4 0 30 60 90; do date -d "$off day" +%Y%m; done | sort -u)
    for lg in $CLUBS $NATS; do
      for m in $MONTHS; do
        f="$MC/$lg-$m.jsonl"
        if [ "$m" = "$CUR" ] || [ ! -f "$f.ok" ] || [ ! -s "$f" ] \
           || { [ "$m" \> "$CUR" ] && [ $((NOW - $(stat -c %Y "$f.ok"))) -gt 86400 ]; }; then
          run "$lg" "$m"
        else
          [ -s "$f" ] && cp "$f" "$tmp/$lg-$m.jsonl"
        fi
      done
    done
    wait
    find ~/.cache/espn-games-months -mindepth 1 -maxdepth 1 -type d -mtime +200 -exec rm -rf {} + 2>/dev/null
    find "$MC" -type f -mtime +200 -delete
    # Cache anti-trous : certaines requetes mensuelles peuvent echouer en
    # silence (timeout), et l'ancien code jetait alors des mois entiers
    # (ex. tous les matchs d'octobre-janvier d'une equipe). On fusionne le
    # frais par-dessus le dernier bon resultat : le frais gagne en cas de
    # doublon, le cache comble les ids absents (purge : passe de +7j, scores
    # en direct perimes, "a venir" deja commence). Ecriture atomique.
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    CACHE=~/.cache/espn-games.json
    CACHE_SIG=~/.cache/espn-games.sig
    if [ -s "$CACHE" ] && [ ! -s "$CACHE.meta" ] && jq -e 'type == "array"' "$CACHE" >/dev/null 2>&1; then cmark "$CACHE" 604800; fi
    OLD="$CACHE"
    if [ "$(cat "$CACHE_SIG" 2>/dev/null)" != "$SIG" ] || ! cvalid "$CACHE" || cstale "$CACHE" || ! jq -e 'type == "array"' "$CACHE" >/dev/null 2>&1; then OLD=/dev/null; fi
    now=$(date +%s)
    cat "$tmp"/*.jsonl 2>/dev/null | jq -sc 'unique_by(.id) | sort_by(.at)' > "$tmp/fresh.json"
    FRESH=$(jq 'length // 0' "$tmp/fresh.json" 2>/dev/null || echo 0)
    if [ -s "$OLD" ] || [ "$FRESH" -gt 0 ]; then
      if [ -s "$OLD" ]; then
        jq -sc --argjson now "$now" '.[0] as $f | .[1] as $c | ($f // []) + ([($c // [])[] | select(.at != null and .at > ($now - 604800) and .state != "in" and (.state != "pre" or .at > ($now - 10800)))]) | unique_by(.id) | sort_by(.at)' "$tmp/fresh.json" "$OLD" > "$tmp/games.json"
      else
        cp "$tmp/fresh.json" "$tmp/games.json"
      fi
    else
      rm -rf -- "$tmp"
      exit 1
    fi
    [ "$(jq 'length // 0' "$tmp/games.json")" -gt 0 ] || { rm -rf -- "$tmp"; exit 1; }
    cp "$tmp/games.json" "$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
    [ "$FRESH" -gt 0 ] && cmark "$CACHE" 604800
    printf '%s' "$SIG" > "$CACHE_SIG"
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    B=~/.cache/espn-logos/banner
    mkdir -p "$B"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    e=~/.cache/espn-logos/empty.png
    [ -s "$e" ] || printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==' | base64 -d > "$e"
    find "$d" -maxdepth 1 -name '*.png' -mtime +30 -delete
    rm -f "$d"/[0-9]*.png
    n=0
    for f in $(jq -r '.[].teams[].logo | select(. != "")' "$tmp/games.json" | sort -u); do
      p=$(echo "$f" | tr '-' '/')
      if [ ! -s "$d/$f" ]; then
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"; [ -s "$d/$f" ] && [ ! -s "$B/$f" ] && cp "$d/$f" "$B/$f"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    # Planche-sprite des ecussons : 1 seul fichier image -> les 50 ecussons
    # apparaissent ensemble au lieu de clignoter en decale. Rebuild seulement
    # si le set de logos change, ecriture atomique (mv) pour ne jamais exposer
    # un fichier partiel. Perl + zlib du systeme uniquement, ~1 s.
    sig=$(find "$d" -maxdepth 1 -name '*.png' -printf '%f %s %T@\n' 2>/dev/null | sort | sha256sum | cut -d' ' -f1)
    if [ "$sig" != "$(cat "$d/.sprite.sig" 2>/dev/null)" ] || [ ! -s ~/.cache/espn-logos/sprite.png ] || [ ! -s ~/.cache/espn-logos/sprite.json ]; then
      perl - "$d" "$tmp/sprite" <<'PERLEOF'
use strict;
use warnings;
use Compress::Zlib qw(compress);
use Compress::Raw::Zlib qw(crc32);
my ($dir, $out) = @ARGV;
opendir(my $dh, $dir) or die "no dir";
my @files = sort grep { /\.png$/ && -f ($dir . "/" . $_) } readdir($dh);
closedir($dh);
sub chunk {
  my ($type, $data) = @_;
  return pack("N", length($data)) . $type . $data . pack("N", crc32($type . $data));
}
sub paeth {
  my ($a, $b, $c) = @_;
  my $p = $a + $b - $c;
  my $pa = abs($p - $a); my $pb = abs($p - $b); my $pc = abs($p - $c);
  return ($pa <= $pb && $pa <= $pc) ? $a : ($pb <= $pc ? $b : $c);
}
sub parse_png {
  my ($path) = @_;
  open(my $fh, "<", $path) or return undef;
  binmode($fh);
  my $magic;
  return undef unless read($fh, $magic, 8) == 8;
  return undef unless $magic eq "\x89PNG\r\n\x1a\n";
  my ($w, $h, $depth, $ctype, $inter);
  my $idat = "";
  while (1) {
    my $hdr;
    last unless read($fh, $hdr, 8) == 8;
    my ($len, $type) = unpack("N a4", $hdr);
    my $data = "";
    if ($len > 0) {
      last unless read($fh, $data, $len) == $len;
    }
    my $crc;
    last unless read($fh, $crc, 4) == 4;
    if ($type eq "IHDR") {
      ($w, $h, $depth, $ctype, my $comp, my $filt, $inter) = unpack("NNCCCCC", $data);
    } elsif ($type eq "IDAT") {
      $idat .= $data;
    } elsif ($type eq "IEND") {
      last;
    }
  }
  close($fh);
  return undef unless defined $w && $w == $h && $w >= 16 && $w <= 256;
  return undef unless $depth == 8 && $ctype == 6 && $inter == 0;
  my $raw = Compress::Zlib::uncompress($idat);
  return undef unless defined $raw;
  my $stride = $w * 4;
  return undef unless length($raw) == $h * ($stride + 1);
  my $rgba = "";
  my @prev = (0) x $stride;
  for my $ry (0 .. $h - 1) {
    my $off = $ry * ($stride + 1);
    my $f = ord(substr($raw, $off, 1));
    my @line = unpack("C*", substr($raw, $off + 1, $stride));
    my @rec = (0) x $stride;
    for my $i (0 .. $stride - 1) {
      my $v = $line[$i];
      my $a = $i >= 4 ? $rec[$i - 4] : 0;
      my $b = $prev[$i];
      my $c = $i >= 4 ? $prev[$i - 4] : 0;
      if ($f == 1) { $v += $a; }
      elsif ($f == 2) { $v += $b; }
      elsif ($f == 3) { $v += int(($a + $b) / 2); }
      elsif ($f == 4) { $v += paeth($a, $b, $c); }
      $rec[$i] = $v & 255;
    }
    $rgba .= pack("C*", @rec);
    @prev = @rec;
  }
  return { w => $w, h => $h, rgba => $rgba };
}
my @names;
my @tiles;
my $cell = 0;
for my $f (@files) {
  my $p = parse_png($dir . "/" . $f);
  next unless $p;
  if ($cell == 0) { $cell = $p->{w}; }
  next unless $p->{w} == $cell;
  push @names, $f;
  push @tiles, $p->{rgba};
}
if (!@tiles) { print STDERR "sprite: no valid tiles\n"; exit 1; }
my $cols = 8;
my $nrows = int((scalar(@tiles) + $cols - 1) / $cols);
my $W = $cols * $cell;
my $H = $nrows * $cell;
my $blank = "\0" x ($cell * 4);
my $raw = "";
for my $ry (0 .. $H - 1) {
  $raw .= "\0";
  my $gr = int($ry / $cell);
  my $lr = $ry % $cell;
  for my $gc (0 .. $cols - 1) {
    my $gi = $gr * $cols + $gc;
    if ($gi < scalar(@tiles)) {
      $raw .= substr($tiles[$gi], $lr * $cell * 4, $cell * 4);
    } else {
      $raw .= $blank;
    }
  }
}
my $idat = compress($raw);
my $png = "\x89PNG\r\n\x1a\n" . chunk("IHDR", pack("NNCCCCC", $W, $H, 8, 6, 0, 0, 0)) . chunk("IDAT", $idat) . chunk("IEND", "");
open(my $oh, ">", $out . ".png") or die;
binmode($oh);
print $oh $png;
close($oh);
open(my $oj, ">", $out . ".json") or die;
print $oj '{"cell":' . $cell . ',"cols":8,"w":' . $W . ',"h":' . $H . ',"idx":{';
for my $i (0 .. $#names) {
  print $oj "," if $i > 0;
  print $oj '"' . $names[$i] . '":' . $i;
}
print $oj "}}";
close($oj);
print STDERR "sprite: " . scalar(@tiles) . " tiles -> " . $W . "x" . $H . "\n";
PERLEOF
      if [ -s "$tmp/sprite.png" ] && [ -s "$tmp/sprite.json" ]; then
        mv "$tmp/sprite.png" "$tmp/sprite.json" ~/.cache/espn-logos/
        printf '%s' "$sig" > "$d/.sprite.sig"
      fi
    fi
    jq -c --argjson now "$(date +%s)" '
      [.[] | select(.state=="in" or
         (.state=="pre" and (.at//0) <= ($now+10800) and (.at//0) >= ($now-10800)))
       | {league, at, state}]
      | unique_by(.league + ":" + (((.at//0)/86400)|floor|tostring))' \
      "$tmp/games.json" > ~/.cache/espn-live-index.json.tmp \
      && mv ~/.cache/espn-live-index.json.tmp ~/.cache/espn-live-index.json
    cat "$tmp/games.json" | jq -c --argjson f "$(date +%s)" 'map(. + {fetchedAt: $f})'
    rm -rf "$tmp"
  """
source games=cmd("bash -c ${sh(gamesScript)}")every 15m json timeout 240s status
let seasonScript="""    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    WANT="""+sh(favStr)+""";
    WANTID="""+sh(favTid)+""";
    WANTNOTID="""+sh(favNoTid)+""";
    WANTLG="""+sh(favLg)+""";
    if [ -z "$WANT" ] && [ -z "$WANTID" ]; then printf '[]'; rm -rf "$tmp"; exit 0; fi
    LG=$(printf '%s' "$WANTLG" | tr ',' ' ')
    if [ -z "$LG" ]; then
      # fallback : etat persiste ancien sans league, on garde le comportement complet
      CLUBS="fra.1 fra.2 fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia ned.1 por.1 tur.1 bel.1 sco.1 gre.1 sui.1 aut.1 den.1 nor.1 swe.1 rou.1 cze.1 isr.1 cyp.1 uefa.europa uefa.europa.conf eng.1 esp.1 ger.1 ita.1 uefa.champions"
      NATS="uefa.nations fifa.worldq.uefa fifa.friendly"
    else
      NONNAT=$(printf '%s\n' $LG | grep -Ev '^(uefa\.nations|fifa\.(worldq\.uefa|friendly))$' || true)
      if [ -n "$NONNAT" ]; then
        CLUBS=$(printf '%s\n' $NONNAT uefa.champions uefa.europa uefa.europa.conf | awk 'NF && !seen[$0]++' | tr '\n' ' ')
        case " $NONNAT " in *" fra.1 "*|*" fra.2 "*) CLUBS="$CLUBS fra.coupe_de_france";; esac
        case " $NONNAT " in *" eng.1 "*) CLUBS="$CLUBS eng.fa eng.league_cup";; esac
        case " $NONNAT " in *" esp.1 "*) CLUBS="$CLUBS esp.copa_del_rey";; esac
        case " $NONNAT " in *" ger.1 "*) CLUBS="$CLUBS ger.dfb_pokal";; esac
        case " $NONNAT " in *" ita.1 "*) CLUBS="$CLUBS ita.coppa_italia";; esac
      else
        CLUBS=""
      fi
      NATS=""
      case " $LG " in
        *" uefa.nations "*|*" fifa.worldq.uefa "*|*" fifa.friendly "*)
          NATS=$(printf '%s\n' $LG uefa.nations fifa.worldq.uefa fifa.friendly | awk 'NF && !seen[$0]++' | tr '\n' ' ') ;;
      esac
    fi
    tagof() {
      if [ "$1" = "fra.1" ]; then printf 'L1'
      elif [ "$1" = "fra.2" ]; then printf 'L2'
      elif [ "$1" = "fra.coupe_de_france" ]; then printf 'CDF'
      elif [ "$1" = "eng.fa" ]; then printf 'FA'
      elif [ "$1" = "eng.league_cup" ]; then printf 'LC'
      elif [ "$1" = "esp.copa_del_rey" ]; then printf 'CDR'
      elif [ "$1" = "ger.dfb_pokal" ]; then printf 'DFB'
      elif [ "$1" = "ita.coppa_italia" ]; then printf 'CI' 
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      elif [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.nations" ]; then printf 'NAT'
      elif [ "$1" = "fifa.worldq.uefa" ]; then printf 'QCM'
      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      r=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 1 --retry-delay 0 --retry-max-time 20 --retry-connrefused -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null) || return 1
      printf '%s' "$r" | jq -e 'type == "object" and (has("events") or has("leagues"))' >/dev/null 2>&1 || return 1
      printf '%s' "$r" | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" --arg wantid "$WANTID" --arg wantnotid "$WANTNOTID" '($want | split(",") | map(select(. != ""))) as $wl | ($wantid | split(",") | map(select(. != ""))) as $wlid | ($wantnotid | split(",") | map(select(. != ""))) as $wln | def dec: ((tostring) | if startswith("+") then .[1:] else . end | (try tonumber catch null)) as $n | if $n == null or $n == 0 then null elif $n > 0 then 1 + ($n / 100) else 1 + (100 / (0 - $n)) end; def O: ([.odds[]? | select(. != null and .moneyline != null)][0]) as $o | if $o == null then null else {h: (($o.moneyline.home.close.odds // $o.moneyline.home.open.odds // $o.homeTeamOdds.moneyLine // null) | dec), d: (($o.moneyline.draw.close.odds // $o.moneyline.draw.open.odds // $o.drawOdds.moneyLine // null) | dec), a: (($o.moneyline.away.close.odds // $o.moneyline.away.open.odds // $o.awayTeamOdds.moneyLine // null) | dec), ho: (($o.moneyline.home.open.odds // null) | dec), do: (($o.moneyline.draw.open.odds // null) | dec), ao: (($o.moneyline.away.open.odds // null) | dec), tot: (($o.total.over.close.line // "") | sub("^[ou]";"") | (try tonumber catch null)), tov: ($o.total.over.close.odds | dec), tun: (($o.total.under.close.line // "") | sub("^[ou]";"") | (try tonumber catch null)), tuv: ($o.total.under.close.odds | dec), sph: (($o.pointSpread.home.close.line // "") | (try tonumber catch null)), sphv: ($o.pointSpread.home.close.odds | dec), spa: (($o.pointSpread.away.close.line // "") | (try tonumber catch null)), spav: ($o.pointSpread.away.close.odds | dec)} end; def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .competitions[0] as $c | {ids: [$c.competitors[]? | .team.id | tostring], abbrs: [$c.competitors[]? | .team.abbreviation]} as $duo | select((($wlid | length) > 0 and ([$duo.ids[] | IN($wlid[])] | any)) or (($wln | length) > 0 and ([$duo.abbrs[] | IN($wln[])] | any)) or ((($wlid | length) == 0 and ($wln | length) == 0) and ([$duo.abbrs[] | IN($wl[])] | any))) | {id: ($lg + ":" + .id), league: $lg, tag: $tag, at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, stage: (.season.slug // ""), squads: ([$c.competitors[] | .team.abbreviation]), tids: $duo.ids, odds: ($c | O), teams: [$c.competitors[] | {side: .homeAway} + T], home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T)}'
    }
    n=0
    : > "$tmp/ok.log"
    run() {
      ( if out=$(fetch "$1" "$2"); then
          printf '%s' "$out" | jq -c --arg m "$2" '. + {month: $m}' > "$tmp/$1-$2.jsonl"
          printf '%s:%s\n' "$1" "$2" >> "$tmp/ok.log"
        fi ) &
      n=$((n + 1))
      if [ "$n" -ge 10 ]; then wait; n=0; fi
    }
    Y=$(date +%Y)
    M=$(date +%-m)
    if [ "$M" -ge 8 ]; then S=$Y; else S=$((Y - 1)); fi
    E=$((S + 1))
    SEASON=""
    for m in 07 08 09 10 11 12; do SEASON="$SEASON $S$m"; done
    for m in 01 02 03 04 05 06 07; do SEASON="$SEASON $E$m"; done
    CAL="nor.1 swe.1"
    CALSEASON=$(for m in 01 02 03 04 05 06 07 08 09 10 11 12; do printf '%s ' "$Y$m"; done)
    # Saison entiere : mois courant toujours rafraichi, mois deja recuperes
    # (meme sans match pour mes equipes) sautes, echecs retentes au run suivant.
    # Les mois futurs restent couverts par games (+/-90 j) une fois proches.
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-season.json
    CUR=$(date +%Y%m)
    sig=$(printf '%s|%s' "$WANTID" "$WANT" | sha256sum | cut -d' ' -f1)
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e '.lms and .items' "$cache" >/dev/null 2>&1; then cmark "$cache" 2592000; fi
    OLD="$cache"
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e '.lms and .items' "$cache" >/dev/null 2>&1; then OLD=/dev/null; printf '{"sig":"","lms":[],"items":[]}' > "$cache.tmp" && mv "$cache.tmp" "$cache"; cmark "$cache" 2592000; fi
    if ! jq -e --arg sig "$sig" '.sig == $sig' "$cache" >/dev/null 2>&1; then
      jq -c --arg sig "$sig" '{sig: $sig, lms: [], items: (.items // [])}' "$cache" > "$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache" || printf '{"sig":"%s","lms":[],"items":[]}' "$sig" > "$cache"
    fi
    for lg in $CLUBS $NATS; do
      case " $CAL " in *" $lg "*) MS="$CALSEASON";; *) MS="$SEASON";; esac
      for m in $MS; do
        if [ "$m" = "$CUR" ] || ! jq -e --arg k "$lg:$m" '.lms | index($k) != null' "$cache" >/dev/null 2>&1; then
          run "$lg" "$m"
        fi
      done
    done
    wait
    OKJ=$(jq -R -s 'split("\n") | map(select(. != ""))' "$tmp/ok.log" 2>/dev/null || printf '[]')
    cat "$tmp"/*.jsonl 2>/dev/null | jq -cs 'unique_by(.id)' > "$tmp/fresh.json"
    # Fusion du frais par-dessus le cache mensuel (le frais gagne) : les mois
    # passes ne sont plus retelecharges, et un echec ressert le cache.
    jq -c --slurpfile fr "$tmp/fresh.json" --argjson ok "$OKJ" --arg keep "$S"07 --arg calkeep "$Y"01 --arg sig "$sig" '
      ($fr[0] // []) as $fresh
      | (.lms // []) as $lms | (.items // []) as $old
      | ([$fresh[] | select(.id != null)] | unique_by(.id)) as $fu
      | ([$fu[] | ((.league // "") + ":" + (.month // ""))] | unique) as $flms
      | ([$old[] | select(.id != null and ((.league // "") + ":" + (.month // "")) as $lm | ($flms | index($lm)) == null)] | unique_by(.id)) as $kept
      | ((($fu + $kept) | unique_by(.id)) | map(select((.month // "0") >= $keep or ((.league == "nor.1" or .league == "swe.1") and (.month // "0") >= $calkeep)))) as $items
      | {cache: {sig: $sig, lms: (($lms + $ok) | unique), items: $items}, out: ($items | sort_by(.at))}
    ' "$OLD" > "$tmp/merged.json" 2>/dev/null || printf '{"out":[]}' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/fresh.json" 2>/dev/null || echo 0)
    if [ "$(jq '.out | length // 0' "$tmp/merged.json" 2>/dev/null || printf 0)" -gt 0 ]; then
      jq -c '.cache' "$tmp/merged.json" > "$tmp/cache.json" && mv "$tmp/cache.json" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 2592000
      jq -c '.out' "$tmp/merged.json" > "$tmp/season.json"
    elif cvalid "$cache" && ! cstale "$cache" && [ "$(jq '.items | length // 0' "$cache" 2>/dev/null || printf 0)" -gt 0 ]; then
      jq -c '.items | sort_by(.at)' "$cache" > "$tmp/season.json" 2>/dev/null || { rm -rf "$tmp"; exit 1; }
      [ "$(jq 'length // 0' "$tmp/season.json")" -gt 0 ] || { rm -rf "$tmp"; exit 1; }
    else
      rm -rf "$tmp"
      exit 1
    fi
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    B=~/.cache/espn-logos/banner
    mkdir -p "$B"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    e=~/.cache/espn-logos/empty.png
    [ -s "$e" ] || printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==' | base64 -d > "$e"
    find "$d" -maxdepth 1 -name '*.png' -mtime +30 -delete
    rm -f "$d"/[0-9]*.png
    n=0
    for f in $(jq -r '.[].teams[].logo | select(. != "")' "$tmp/season.json" | sort -u); do
      p=$(echo "$f" | tr '-' '/')
      if [ ! -s "$d/$f" ]; then
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"; [ -s "$d/$f" ] && [ ! -s "$B/$f" ] && cp "$d/$f" "$B/$f"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    cat "$tmp/season.json"
    rm -rf "$tmp"
  """
source seasonAll=cmd("bash -c ${sh(seasonScript)}")every 12h json timeout 900s status
source scheds=cmd("""
    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    sched() {
      lg=$1
      id=$2
      raw=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 2 --retry-delay 0 --retry-max-time 30 --retry-connrefused -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/teams/$id/schedule" 2>/dev/null)
      printf '%s' "$raw" | jq -c --arg lg "$lg" '[((.events // []) | sort_by(.date)) | to_entries[] | {key: ($lg + ":" + (.value.id | tostring)), value: (if $lg == "fra.coupe_de_france" then "" elif $lg == "uefa.europa" and .key + 1 > 8 then "Finales" else "J\(.key + 1)" end)}] | from_entries | with_entries(select(.value != ""))' > "$tmp/sched-$lg-$id.json"
      printf '%s' "$raw" | jq -c --arg lg "$lg" '((.events // []) | sort_by(.date)) as $e | {($lg): {jn: ($e | length), at: (if ($e | length) > 0 then ($e[-1].date[0:16] + ":00Z" | fromdateiso8601) else 0 end)}}' > "$tmp/anchor-$lg-$id.json"
    }
    sched fra.1 167
    sched fra.2 6994
    sched fra.coupe_de_france 167
    sched fra.coupe_de_france 6994
    sched uefa.europa 167
    sched uefa.nations 478
    sched fifa.worldq.uefa 478
    jq -s 'add' "$tmp"/sched-*.json > "$tmp/rounds.json"
    jq -s 'add' "$tmp"/anchor-*.json > "$tmp/anchors.json"
    [ "$(jq 'length // 0' "$tmp/rounds.json")" -gt 0 ] || exit 1
    jq -cs '{rounds: .[0], anchors: .[1]}' "$tmp/rounds.json" "$tmp/anchors.json"
    rm -rf "$tmp"
  """)every 24h json timeout 900s status
let standingsScript="""    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    WANT="""+sh(favStr)+""";
    WANTID="""+sh(favTid)+""";
    WANTNOTID="""+sh(favNoTid)+""";
    WANTLG="""+sh(favLg)+""";
    TABLESALL="fra.1 fra.2 ned.1 por.1 tur.1 bel.1 sco.1 gre.1 sui.1 aut.1 den.1 nor.1 swe.1 rou.1 cze.1 isr.1 cyp.1 uefa.europa uefa.europa.conf uefa.nations fifa.worldq.uefa eng.1 esp.1 ger.1 ita.1 uefa.champions"
    LG=$(printf '%s' "$WANTLG" | tr ',' ' ')
    if [ -z "$LG" ]; then
      TABLES="eng.1 esp.1 ger.1 ita.1 fra.1 uefa.champions uefa.europa uefa.europa.conf"
    else
      TABLES=$(for l in eng.1 esp.1 ger.1 ita.1 fra.1 uefa.champions uefa.europa uefa.europa.conf $LG; do
        case " $TABLESALL " in *" $l "*) printf '%s ' "$l";; esac
      done | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ')
    fi
    tagof() {
      if [ "$1" = "fra.1" ]; then printf 'L1'
