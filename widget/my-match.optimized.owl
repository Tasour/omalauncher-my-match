      > "$tmp/live.json" 2>/dev/null || printf '{"at":%s,"items":[]}' "$now" > "$tmp/live.json"
    if [ "$(jq '.items|length' "$tmp/live.json" 2>/dev/null || echo 1)" -eq 0 ] \
       && [ -s "$LAST" ] && [ $((now - $(jq '.at // 0' "$LAST"))) -lt 600 ]; then
      cp "$LAST" "$tmp/live.json"
    fi
    cp "$tmp/live.json" "$LAST.tmp" && mv "$LAST.tmp" "$LAST"
    cat "$LAST"
    rm -rf -- "$tmp"
  """
source now=clock every 15s
source liveIdx=file("~/.cache/espn-live-index.json")json
let liveWin=count(myTeams)>0&&(flatten([games.out??[],extra.out??[]]).any(g=>g.at!=null&&(g.state=="in"||(g.state=="pre"&&g.at>now-10800&&g.at<=now+120)))||(liveIdx??[]).any(g=>g.at!=null&&(g.state=="in"||(g.state=="pre"&&g.at>now-10800&&g.at<=now+120))))
let liveCmd=liveWin?"bash -c "+sh(liveScript):"printf '{\"items\":[],\"at\":0}'"
source liveM=cmd(liveCmd) every 1m json timeout 90s status
source knock=cmd("""
    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    LEAGUES="uefa.champions uefa.europa uefa.europa.conf"
    tagof() {
      if [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      if r=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 1 --retry-delay 0 --retry-max-time 20 --retry-connrefused -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null) && [ -n "$r" ]; then
        printf '%s' "$r" | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" '($want | split(",") | map(select(. != ""))) as $wl | def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .season.slug as $round | .competitions[0] as $c | {id: ($lg + ":" + (.id | tostring)), league: $lg, tag: $tag, stage: $round, at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, squads: ([$c.competitors[] | .team.abbreviation]), home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T), aggH: (($c.competitors[] | select(.homeAway == "home") | (.team.id | tostring)) as $hid | ([$c.series.competitors[]? | select(.id == $hid) | .aggregateScore] | .[0] // null)), aggA: (($c.competitors[] | select(.homeAway == "away") | (.team.id | tostring)) as $aid | ([$c.series.competitors[]? | select(.id == $aid) | .aggregateScore] | .[0] // null)), aggDone: ($c.series.completed // false)}' > "$tmp/$lg-$d.jsonl" && echo ok >> "$tmp/ok.log"
      fi
    }
    n=0
    run() {
      fetch "$1" "$2" &
      n=$((n + 1))
      if [ "$n" -ge 10 ]; then wait; n=0; fi
    }
    Y=$(date +%Y)
    M=$(date +%-m)
    if [ "$M" -ge 8 ]; then S=$Y; else S=$((Y - 1)); fi
    E=$((S + 1))
    for lg in $LEAGUES; do
      for m in "$E"02 "$E"03 "$E"04 "$E"05; do
        run "$lg" "$m"
      done
    done
    wait
    # Au moins une reponse valide exigee (sinon echec) ; zero evenement
    # est un succes normal hors saison (l'arbre s'affichera plus tard).
    [ -s "$tmp/ok.log" ] || exit 1
    cat "$tmp"/*.jsonl 2>/dev/null | jq -cs 'unique_by(.id) | sort_by(.at)' > "$tmp/knock.json" 2>/dev/null || echo '[]' > "$tmp/knock.json"
    # Fusion anti-trous : le frais gagne par id, le cache comble les tours
    # absents ; on ne garde que la saison en cours (pas l'arbre precedent).
    keep=$(date -d "$S-09-01" +%s)
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-knock.json
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then cmark "$cache" 604800; fi
    OLD="$cache"
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then OLD=/dev/null; fi
    jq -cs --argjson keep "$keep" '.[1] as $old | (.[0] // []) as $fu | ([$fu[] | .id] | unique) as $fresh | ($fu + ([($old // [])[]] | map(.id as $id | select($id != null and (.at // 0) >= $keep and ($fresh | index($id)) == null)))) | unique_by(.id) | sort_by(.at)' "$tmp/knock.json" "$OLD" > "$tmp/merged.json" 2>/dev/null || printf '[]' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/knock.json" 2>/dev/null || echo 0)
    if [ "$(jq 'length // 0' "$tmp/merged.json")" -gt 0 ]; then
      cp "$tmp/merged.json" "$cache.tmp" && mv "$cache.tmp" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 604800
      cp "$tmp/merged.json" "$tmp/knock.json"
    elif cvalid "$cache" && ! cstale "$cache" 604800 && [ -s "$cache" ] && [ "$(jq 'length // 0' "$cache" 2>/dev/null || printf 0)" -gt 0 ]; then
      cp "$cache" "$tmp/knock.json"
    fi
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    n=0
    for f in $(jq -r '.[].home.logo, .[].away.logo | select(. != null and . != "")' "$tmp/knock.json" | sort -u); do
      if [ ! -s "$d/$f" ]; then
        p=$(echo "$f" | tr '-' '/')
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    cat "$tmp/knock.json"
    rm -rf "$tmp"
  """)every 12h json timeout 120s status
source nextup=cmd("""
    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    WANTLG="""+sh(favLg)+""";
    ALLLG="fra.1 fra.2 ned.1 por.1 tur.1 bel.1 sco.1 gre.1 sui.1 aut.1 den.1 nor.1 swe.1 rou.1 cze.1 isr.1 cyp.1 uefa.europa uefa.europa.conf uefa.nations fifa.worldq.uefa fifa.friendly eng.1 esp.1 ger.1 ita.1 uefa.champions"
    LEAGUES="fra.1 fra.2 uefa.europa uefa.europa.conf uefa.nations fifa.worldq.uefa fifa.friendly eng.1 esp.1 ger.1 ita.1 uefa.champions"
    for l in $(printf '%s' "$WANTLG" | tr ',' ' '); do
      case " $ALLLG " in *" $l "*) case " $LEAGUES " in *" $l "*) ;; *) LEAGUES="$LEAGUES $l";; esac;; esac
    done
    tagof() {
      if [ "$1" = "fra.1" ]; then printf 'L1'
      elif [ "$1" = "fra.2" ]; then printf 'L2'
      elif [ "$1" = "fra.coupe_de_france" ]; then printf 'CDF'
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      elif [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.nations" ]; then printf 'NAT'
      elif [ "$1" = "fifa.worldq.uefa" ]; then printf 'QCM'
      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
      elif [ "$1" = "eng.1" ]; then printf 'ENG'
      elif [ "$1" = "esp.1" ]; then printf 'ESP'
      elif [ "$1" = "ger.1" ]; then printf 'GER'
      elif [ "$1" = "ita.1" ]; then printf 'ITA'
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      if r=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 0 -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null) && [ -n "$r" ]; then
        printf '%s' "$r" | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" '($want | split(",") | map(select(. != ""))) as $wl | def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .competitions[0] as $c | select($c.status.type.state == "pre") | {id: ($lg + ":" + (.id | tostring)), league: $lg, tag: $tag, stage: (.season.slug // ""), at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, squads: ([$c.competitors[] | .team.abbreviation]), home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T)}' > "$tmp/$lg-$d.jsonl" && echo ok >> "$tmp/ok.log"
      fi
    }
    n=0
    run() {
      fetch "$1" "$2" > "$tmp/$1-$2.jsonl" &
      n=$((n + 1))
      if [ "$n" -ge 5 ]; then wait; n=0; sleep 1; fi
    }
    # Mois courant inclus (sinon la journee en cours, ex. J3 C1 du mois en
    # cours, est sautee) + 3 mois suivants.
    MONTHS=$(for off in 0 30 60 90; do date -d "$off day" +%Y%m; done | sort -u)
    for lg in $LEAGUES; do
      for m in $MONTHS; do
        run "$lg" "$m"
      done
    done
    wait
    [ -s "$tmp/ok.log" ] || exit 1
    cat "$tmp"/*.jsonl 2>/dev/null | jq -cs 'unique_by(.id) | group_by(.league) | map(if (.[0].league == "uefa.champions" or .[0].league == "uefa.europa" or .[0].league == "uefa.europa.conf") then (sort_by(.at) | .[0:18]) else (sort_by(.at) | .[0:8]) end) | add // []' > "$tmp/next.json" 2>/dev/null || echo '[]' > "$tmp/next.json"
    # Fusion anti-trous : le frais gagne par id, le cache comble les ligues
    # absentes ; on purge les affiches passees de plus d'un jour (jouees).
    now=$(date +%s)
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-nextup.json
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then cmark "$cache" 86400; fi
    OLD="$cache"
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then OLD=/dev/null; fi
    jq -cs --argjson cut "$((now - 86400))" '.[1] as $old | (.[0] // []) as $fu | ([$fu[] | .id] | unique) as $fresh | ($fu + ([($old // [])[]] | map(.id as $id | select($id != null and (.at // 0) > $cut and ($fresh | index($id)) == null)))) | unique_by(.id) | sort_by(.at)' "$tmp/next.json" "$OLD" > "$tmp/merged.json" 2>/dev/null || printf '[]' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/next.json" 2>/dev/null || echo 0)
    if [ "$(jq 'length // 0' "$tmp/merged.json")" -gt 0 ]; then
      cp "$tmp/merged.json" "$cache.tmp" && mv "$cache.tmp" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 86400
      cp "$tmp/merged.json" "$tmp/next.json"
    elif cvalid "$cache" && ! cstale "$cache" && [ -s "$cache" ] && [ "$(jq 'length // 0' "$cache" 2>/dev/null || printf 0)" -gt 0 ]; then
      jq -c --argjson cut "$((now - 86400))" 'map(select((.at // 0) > $cut))' "$cache" > "$tmp/next.json"
    fi
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    n=0
    for f in $(jq -r '.[].home.logo, .[].away.logo | select(. != null and . != "")' "$tmp/next.json" | sort -u); do
      if [ ! -s "$d/$f" ]; then
        p=$(echo "$f" | tr '-' '/')
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    cat "$tmp/next.json"
    rm -rf "$tmp"
  """)every 12h json timeout 360s status
