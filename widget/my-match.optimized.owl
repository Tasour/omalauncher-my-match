      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      elif [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.nations" ]; then printf 'NAT'
      elif [ "$1" = "fifa.worldq.uefa" ]; then printf 'QCM'
      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
