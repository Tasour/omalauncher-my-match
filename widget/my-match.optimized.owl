      fi
    }
    n=0
    one() {
      lg=$1
      tag=$(tagof "$lg")
      s=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 2 --retry-delay 0 --retry-max-time 30 --retry-connrefused -fsm 15 --compressed "https://site.api.espn.com/apis/v2/sports/soccer/$lg/standings" 2>/dev/null)
      e=$(printf '%s' "$s" | jq -r '.season.endDate // "none"')
      case "$e" in ""|"none") e=9999999999;; *) e=$(date -d "$e" +%s || printf 9999999999);; esac
      printf '%s' "$s" | jq -c --arg lg "$lg" --arg tag "$tag" --argjson ends "$e" --arg want "$WANT" --arg wantid "$WANTID" '($want | split(",") | map(select(. != ""))) as $wl | ($wantid | split(",") | map(select(. != ""))) as $wlid | [.children[] | {name: (.name | sub("[\r\n]+$"; "")), teams: ([.standings.entries[] | select(.stats != null) | (reduce .stats[] as $s ({}; .[$s.name] = ($s.value // 0 | floor))) as $st | {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), rank: $st.rank, played: $st.gamesPlayed, won: $st.wins, drawn: $st.ties, lost: $st.losses, bp: (($st.pointsFor // null) | if . != null then floor else null end), bc: (($st.pointsAgainst // null) | if . != null then floor else null end), gd: $st.pointDifferential, pts: $st.points, ours: (.team.abbreviation as $a | (.team.id // "" | tostring) as $i | if ($i | IN($wlid[])) then $a elif ($a | IN($wl[])) then $a else null end), zone: ((.note.description // "") | ascii_downcase | if . == "" then null elif test("relegat") and test("playoff") then "orange" elif test("relegat|eliminat") then "red" elif test("champions league$|round of 16|qualifies for world cup$|qualifies for qfs|promotion$") then "green" else "blue" end), zlabel: ((.note.description // "") | ascii_downcase | if test("champions") and test("qualifying") then "prelim. C1" elif test("champions") then "C1" elif test("round") and test("16") then "8es" elif test("conference") then "CONF" elif test("europa") then "C3" elif test("qfs") then "quarts" elif test("promotion") and test("playoff") then "barr. montee" elif test("promotion") then "montee" elif test("world") and test("cup") and test("playoff") then "barr. CDM" elif test("world") and test("cup") then "CDM" elif test("knockout") then "barrages" elif test("relegation") and test("playoff") then "barr. releg." elif test("relegation") then "relegation" elif test("eliminat") then "elimine" else "" end)}] | sort_by(.rank))}] | map(select(((.teams | map(select(.ours != null)) | length) > 0) or ($lg == "eng.1" or $lg == "esp.1" or $lg == "ger.1" or $lg == "ita.1" or $lg == "uefa.champions" or $lg == "uefa.europa" or $lg == "uefa.europa.conf"))) | .[] | {league: $lg, tag: $tag, group: .name, ends: $ends, teams: .teams, squads: ([.teams[].ours] | map(select(. != null)) | unique), legend: ([.teams[] | select(.zone != null) | {c: .zone, t: .zlabel, r: .rank}] | sort_by(.r) | map({c, t}) | reduce .[] as $x ([]; if index($x) then . else . + [$x] end))}' > "$tmp/t-$lg.jsonl"
    }
    for lg in $TABLES; do
      one "$lg" &
      n=$((n + 1))
      if [ "$n" -ge 5 ]; then wait; n=0; sleep 1; fi
    done
    wait
    jq -sc '.' "$tmp"/t-*.jsonl > "$tmp/tables.json" 2>/dev/null || echo '[]' > "$tmp/tables.json"
    # Fusion anti-trous : le frais gagne par (ligue, groupe), le dernier bon
    # resultat comble les ligues absentes (fetch partiel). Sans cache, echec.
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-standings.json
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then cmark "$cache" 604800; fi
    OLD="$cache"
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then OLD=/dev/null; fi
    jq -cs '.[1] as $old | (.[0] // []) as $fu | ([($fu[]) | select(.league != null) | {key: ((.league // "") + ":" + (.group // "")), value: .}] | from_entries) as $fm | $fu + ([($old // [])[]] | map(select($fm[((.league // "") + ":" + (.group // ""))] == null)))' "$tmp/tables.json" "$OLD" > "$tmp/merged.json" 2>/dev/null || printf '[]' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/tables.json" 2>/dev/null || echo 0)
    if [ "$(jq 'length // 0' "$tmp/merged.json")" -gt 0 ]; then
      cp "$tmp/merged.json" "$cache.tmp" && mv "$cache.tmp" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 604800
    elif cvalid "$cache" && ! cstale "$cache" 604800 && [ -s "$cache" ] && [ "$(jq 'length // 0' "$cache" 2>/dev/null || printf 0)" -gt 0 ]; then
      cp "$cache" "$tmp/merged.json"
    else
      rm -rf "$tmp"
      exit 1
    fi
    cat "$tmp/merged.json"
    rm -rf "$tmp"
  """
source standings=cmd("bash -c ${sh(standingsScript)}")every 6h json timeout 300s status
source teamsDb=cmd("""
    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    LEAGUES="fra.1 fra.2 fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia ned.1 por.1 tur.1 bel.1 sco.1 gre.1 sui.1 aut.1 den.1 nor.1 swe.1 rou.1 cze.1 isr.1 cyp.1 eng.1 esp.1 ger.1 ita.1 uefa.champions uefa.europa uefa.europa.conf uefa.nations fifa.worldq.uefa fifa.friendly"
    tagof() {
      if [ "$1" = "fra.1" ]; then printf 'L1'
      elif [ "$1" = "fra.2" ]; then printf 'L2'
      elif [ "$1" = "fra.coupe_de_france" ]; then printf 'CDF'
      elif [ "$1" = "eng.fa" ]; then printf 'FA'
      elif [ "$1" = "eng.league_cup" ]; then printf 'LC'
      elif [ "$1" = "esp.copa_del_rey" ]; then printf 'CDR'
      elif [ "$1" = "ger.dfb_pokal" ]; then printf 'DFB'
      elif [ "$1" = "ita.coppa_italia" ]; then printf 'CI' 
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      elif [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.nations" ]; then printf 'NAT'
      elif [ "$1" = "fifa.worldq.uefa" ]; then printf 'QCM'
      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
      elif [ "$1" = "eng.1" ]; then printf 'ENG'
      elif [ "$1" = "esp.1" ]; then printf 'ESP'
      elif [ "$1" = "ger.1" ]; then printf 'GER'
      elif [ "$1" = "ita.1" ]; then printf 'ITA'
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      else printf '%s' "$1"
      fi
    }
    n=0
    for lg in $LEAGUES; do
      tag=$(tagof "$lg")
      kind=c
      case "$lg" in uefa.nations|fifa.worldq.uefa|fifa.friendly) kind=n;; esac
      curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 1 --retry-delay 0 --retry-max-time 20 --retry-connrefused -fsm 15 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/teams" 2>/dev/null | jq -c --arg lg "$lg" --arg tag "$tag" --arg kind "$kind" '.sports[0].leagues[0].teams[]? | .team as $t | (($t.abbreviation // "") | tostring | gsub("[,\r\n\t]"; "") | .[0:16]) as $a | (($t.id // "") | tostring | gsub("[^0-9]"; "") | .[0:16]) as $i | {key: ((if $a != "" then $a else $i end) + ":" + $kind), name: $t.displayName, short: ($t.shortDisplayName // $t.displayName), abbr: $a, display: $t.displayName, logo: ((($t.logos[0].href // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9.]+[.]png$") then gsub("/"; "-") else "" end), league: $lg, tag: $tag, kind: $kind, tid: $i}' > "$tmp/t-$lg.jsonl" &
      n=$((n + 1))
      if [ "$n" -ge 6 ]; then wait; n=0; fi
    done
    wait
    cat "$tmp"/t-*.jsonl 2>/dev/null | jq -cs 'map(select((.abbr // "") != "" and .name != null)) | group_by(.key) | map((map(.league) | unique) as $lgs | (max_by(if .league == "fifa.friendly" then 0 elif .league == "fifa.worldq.uefa" then 1 elif (.league == "uefa.champions" or .league == "uefa.europa" or .league == "uefa.europa.conf") then 2 else 3 end)) + {leagues: $lgs})' > "$tmp/teams.json" 2>/dev/null || echo '[]' > "$tmp/teams.json"
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-teams.json
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then cmark "$cache" 2592000; fi
    OLD="$cache"
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e 'type == "array"' "$cache" >/dev/null 2>&1; then OLD=/dev/null; fi
    FRESH=$(jq 'length // 0' "$tmp/teams.json" 2>/dev/null || echo 0)
    if [ "$(jq 'length // 0' "$tmp/teams.json")" -gt 0 ]; then
      jq -cs '.[0] as $new | .[1] as $old | ([$new[] | {key: .key, value: .}] | from_entries) as $m | $new + ([$old[] | select($m[.key] == null)])' "$tmp/teams.json" "$OLD" > "$tmp/merged.json" 2>/dev/null || cp "$tmp/teams.json" "$tmp/merged.json"
      cp "$tmp/merged.json" "$cache.tmp" && mv "$cache.tmp" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 2592000
      cp "$tmp/merged.json" "$tmp/teams.json"
    elif cvalid "$cache" && ! cstale "$cache" 2592000 && [ -s "$cache" ] && [ "$(jq 'length // 0' "$cache" 2>/dev/null || echo 0)" -gt 0 ]; then
      cp "$cache" "$tmp/teams.json"
    else
      rm -rf -- "$tmp"
      exit 1
    fi
    # Ecussons du catalogue (setup + headers) : telecharges une fois dans le
    # dossier partage (sprite reconstruit par games apres validation).
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    B=~/.cache/espn-logos/banner
    mkdir -p "$B"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    e=~/.cache/espn-logos/empty.png
    [ -s "$e" ] || printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==' | base64 -d > "$e"
    n=0
    for f in $(jq -r '.[].logo | select(. != "")' "$tmp/teams.json" | sort -u); do
      p=$(echo "$f" | tr '-' '/')
      if [ ! -s "$d/$f" ]; then
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 3 -fsm 6 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"; [ -s "$d/$f" ] && [ ! -s "$B/$f" ] && cp "$d/$f" "$B/$f"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    cat "$tmp/teams.json"
    rm -rf "$tmp"
  """)every 168h json timeout 900s status
source extra=cmd("""
    set -o pipefail
    tmp=$(mktemp -d /tmp/espn.XXXXXX)
    cleanup() {
      rc=$?
      trap - EXIT INT TERM
      kill $(jobs -p) 2>/dev/null
      case "$tmp" in /tmp/espn.*) rm -rf -- "$tmp";; esac
      exit $rc
    }
    trap cleanup EXIT INT TERM
    j=$(od -An -N1 -tu1 /dev/urandom 2>/dev/null | tr -d ' '); sleep $(( ${j:-0} % 3 ))
    NOW=$(date +%s)
    WANTLG="""+sh(favLg)+""";
    ALLLG="fra.1 fra.2 ned.1 por.1 tur.1 bel.1 sco.1 gre.1 sui.1 aut.1 den.1 nor.1 swe.1 rou.1 cze.1 isr.1 cyp.1 uefa.europa uefa.europa.conf uefa.nations fifa.worldq.uefa fifa.friendly eng.1 esp.1 ger.1 ita.1 uefa.champions fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia"
    LEAGUES="fra.1 fra.2 uefa.europa uefa.europa.conf uefa.nations fifa.worldq.uefa fifa.friendly eng.1 esp.1 ger.1 ita.1 uefa.champions fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia"
    for l in $(printf '%s' "$WANTLG" | tr ',' ' '); do
      case " $ALLLG " in *" $l "*) case " $LEAGUES " in *" $l "*) ;; *) LEAGUES="$LEAGUES $l";; esac;; esac
    done
    tagof() {
      if [ "$1" = "fra.1" ]; then printf 'L1'
      elif [ "$1" = "fra.2" ]; then printf 'L2'
      elif [ "$1" = "fra.coupe_de_france" ]; then printf 'CDF'
      elif [ "$1" = "eng.fa" ]; then printf 'FA'
      elif [ "$1" = "eng.league_cup" ]; then printf 'LC'
      elif [ "$1" = "esp.copa_del_rey" ]; then printf 'CDR'
      elif [ "$1" = "ger.dfb_pokal" ]; then printf 'DFB'
      elif [ "$1" = "ita.coppa_italia" ]; then printf 'CI' 
      elif [ "$1" = "uefa.europa" ]; then printf 'EUR'
      elif [ "$1" = "uefa.europa.conf" ]; then printf 'CONF'
      elif [ "$1" = "uefa.champions" ]; then printf 'C1'
      elif [ "$1" = "uefa.nations" ]; then printf 'NAT'
      elif [ "$1" = "fifa.worldq.uefa" ]; then printf 'QCM'
      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
      elif [ "$1" = "eng.1" ]; then printf 'ENG'
      elif [ "$1" = "esp.1" ]; then printf 'ESP'
      elif [ "$1" = "ger.1" ]; then printf 'GER'
      elif [ "$1" = "ita.1" ]; then printf 'ITA'
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 0 -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" '($want | split(",") | map(select(. != ""))) as $wl | def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .competitions[0] as $c | select($c.status.type.state == "post" or $c.status.type.state == "in") | {id: ($lg + ":" + (.id | tostring)), league: $lg, tag: $tag, stage: (.season.slug // ""), at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, squads: ([$c.competitors[] | .team.abbreviation]), teams: [$c.competitors[] | {side: .homeAway} + T], home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T)}'
    }
    n=0
    run() {
      fetch "$1" "$2" | jq -c --arg m "$2" '. + {month: $m}' > "$tmp/$1-$2.jsonl" &
      n=$((n + 1))
      if [ "$n" -ge 5 ]; then wait; n=0; sleep 1; fi
    }
    RR="fra.1 fra.2 fra.coupe_de_france eng.fa eng.league_cup esp.copa_del_rey ger.dfb_pokal ita.coppa_italia eng.1 esp.1 ger.1 ita.1"
    MONTHS5=$(for off in 0 30 60 90 120; do date -d "$off day ago" +%Y%m; done | sort -u)
    MONTHS2=$(for off in 0 30; do date -d "$off day ago" +%Y%m; done | sort -u)
    # Mois passes deja en cache : immuables, on ne refetch que le courant.
    CV=1
    cvalid() { [ -s "$1" ] && [ -s "$1.meta" ] && [ "$(jq -r '.v // 0' "$1.meta" 2>/dev/null)" = "$CV" ]; }
    cstale() { [ "$(jq -r '.exp // 0' "$1.meta" 2>/dev/null || echo 0)" -le "$(date +%s)" ]; }
    cmark() { ttl=${2:-604800}; now=$(date +%s); printf '{"v":%s,"at":%s,"ttl":%s,"exp":%s}' "$CV" "$now" "$ttl" "$((now+ttl))" > "$1.meta.$$.tmp" && mv "$1.meta.$$.tmp" "$1.meta"; }
    cache=~/.cache/espn-extra-base.json
    CUR=$(date +%Y%m)
    KEEPM=$(date -d "120 day ago" +%Y%m)
    if [ -s "$cache" ] && [ ! -s "$cache.meta" ] && jq -e '.lms and .items' "$cache" >/dev/null 2>&1; then cmark "$cache" 2592000; fi
    if ! cvalid "$cache" || cstale "$cache" || ! jq -e '.lms and .items' "$cache" >/dev/null 2>&1; then printf '{"lms":[],"items":[]}' > "$cache.tmp" && mv "$cache.tmp" "$cache"; cmark "$cache" 2592000; fi
    for lg in $LEAGUES; do
      case " $RR " in *" $lg "*) MS="$MONTHS5";; *) MS="$MONTHS2";; esac
      for m in $MS; do
        if [ "$m" -ge "$CUR" ] || ! jq -e --arg k "$lg:$m" '.lms | index($k) != null' "$cache" >/dev/null 2>&1; then
          run "$lg" "$m"
        fi
      done
    done
    wait
    cat "$tmp"/*.jsonl 2>/dev/null | jq -cs 'unique_by(.id)' > "$tmp/fresh.json"
    # Meme cache mensuel que seasonAll : le passe ne se retelemcharge pas,
    # echec = on ressert le dernier bon resultat.
    jq -c --slurpfile fr "$tmp/fresh.json" --arg cur "$CUR" --arg keep "$KEEPM" '
      ($fr[0] // []) as $fresh
      | (.lms // []) as $lms | (.items // []) as $old
      | ([$fresh[] | select(.id != null)] | unique_by(.id)) as $fu
      | ([$fu[] | ((.league // "") + ":" + (.month // ""))] | unique) as $flms
      | ([$old[] | select(.id != null and ((.league // "") + ":" + (.month // "")) as $lm | ($flms | index($lm)) == null)] | unique_by(.id)) as $kept
      | ((($fu + $kept) | unique_by(.id)) | map(select((.month // "0") >= $keep))) as $items
      | {cache: {lms: (($lms + ($flms | map(select((split(":")[1] // "0") < $cur)))) | unique | map(select((split(":")[1] // "0") >= $keep))), items: $items}, out: ($items | sort_by(.at))}
    ' "$cache" > "$tmp/merged.json" 2>/dev/null || printf '{"out":[]}' > "$tmp/merged.json"
    FRESH=$(jq 'length // 0' "$tmp/fresh.json" 2>/dev/null || echo 0)
    if [ "$(jq '.out | length // 0' "$tmp/merged.json" 2>/dev/null || printf 0)" -gt 0 ]; then
      jq -c '.cache' "$tmp/merged.json" > "$tmp/cache.json" && mv "$tmp/cache.json" "$cache"
      [ "$FRESH" -gt 0 ] && cmark "$cache" 2592000
      jq -c '.out' "$tmp/merged.json" > "$tmp/baseraw.json"
    elif cvalid ~/.cache/espn-extra.json && ! cstale ~/.cache/espn-extra.json 604800 && [ -s ~/.cache/espn-extra.json ]; then
      cat ~/.cache/espn-extra.json
      rm -rf "$tmp"
      exit 0
    else
      rm -rf "$tmp"
      exit 1
    fi
    jq -c 'unique_by(.id) | group_by(.league) | map(sort_by(.at) | reverse | .[0:30]) | add // []' "$tmp/baseraw.json" > "$tmp/base.json"
    [ "$(jq 'length // 0' "$tmp/base.json")" -gt 0 ] || exit 1
    # Journees des 6 championnats a poule : K = matchs par journee, n =
    # journee en cours (mode des matchs joues au classement). Les K plus
    # recents forment Jn, les K precedents Jn-1, etc. Exact hors reports.
    n=0
    rrun() {
      lg=$1
      if [ "$lg" = "fra.1" ] || [ "$lg" = "fra.2" ] || [ "$lg" = "ger.1" ]; then k=9; elif [ "$lg" = "uefa.champions" ]; then k=18; else k=10; fi
      nn=$(curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 2 --retry-delay 0 --retry-max-time 30 --retry-connrefused -fsm 15 --compressed "https://site.api.espn.com/apis/v2/sports/soccer/$lg/standings" 2>/dev/null | jq '[.children[].standings.entries[] | select(.stats != null) | (.stats | map(select(.name == "gamesPlayed"))[0].value // 0 | floor)] | group_by(.) | max_by(length) | .[0] // 0')
      [ "$nn" = "" ] && nn=0
      if [ "$nn" -gt 0 ] 2>/dev/null; then
        jq -c --arg lg "$lg" --argjson k "$k" --argjson n "$nn" '[.[] | select(.league == $lg)] | sort_by(.at) | length as $len | to_entries[] | {id: .value.id, round: ($n - ((($len - 1 - .key) / $k) | floor))} | select(.round > 0)' "$tmp/base.json" > "$tmp/rounds-$lg.json"
      else
        : > "$tmp/rounds-$lg.json"
      fi &
      n=$((n + 1))
      if [ "$n" -ge 6 ]; then wait; n=0; fi
    }
    for lg in $RR; do
      rrun "$lg"
    done
    wait
    jq -sc 'map(select(.round != null and .round > 0)) | map({(.id): .round}) | add // {}' "$tmp"/rounds-*.json > "$tmp/roundmap.json"
    jq -cs '.[1] as $r | .[0] | map(. + {round: ($r[.id] // null)}) | sort_by(.at) | reverse' "$tmp/base.json" "$tmp/roundmap.json" > "$tmp/extra.json"
    if [ "$(jq 'length // 0' "$tmp/extra.json")" -gt 0 ]; then
      cp "$tmp/extra.json" ~/.cache/espn-extra.json.tmp && mv ~/.cache/espn-extra.json.tmp ~/.cache/espn-extra.json
      [ "$FRESH" -gt 0 ] && cmark ~/.cache/espn-extra.json 86400
    elif cvalid ~/.cache/espn-extra.json && ! cstale ~/.cache/espn-extra.json 604800 && [ -s ~/.cache/espn-extra.json ]; then
      cat ~/.cache/espn-extra.json
      rm -rf "$tmp"
      exit 0
    else
      rm -rf "$tmp"
      exit 1
    fi
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    B=~/.cache/espn-logos/banner
    mkdir -p "$B"
    find "$d" -maxdepth 1 -name '.*.lock' -mmin +15 -exec rmdir {} + 2>/dev/null
    find "$d" -maxdepth 1 -name '.*.tmp' -mmin +15 -delete 2>/dev/null
    n=0
    for f in $(jq -r '.[].teams[].logo | select(. != "")' "$tmp/extra.json" | sort -u); do
      p=$(echo "$f" | tr '-' '/')
      if [ ! -s "$d/$f" ]; then
        dltmp="$d/.$f.$$.tmp"; dlock="$d/.$f.lock"
        if mkdir "$dlock" 2>/dev/null; then
          if [ ! -s "$d/$f" ]; then
            curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 -fsm 15 -o "$dltmp" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/$p&w=48&h=48" 2>/dev/null && [ -s "$dltmp" ] && mv "$dltmp" "$d/$f" || rm -f "$dltmp"; [ -s "$d/$f" ] && [ ! -s "$B/$f" ] && cp "$d/$f" "$B/$f"
          fi
          rmdir "$dlock"
        fi &
        n=$((n + 1))
        if [ "$n" -ge 8 ]; then wait; n=0; fi
      fi
    done
    wait
    cat "$tmp/extra.json"
    rm -rf "$tmp"
  """)every 1h json timeout 360s status
