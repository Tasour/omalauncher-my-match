let sprPath="~/.cache/espn-logos/sprite.png"
let sprOk=spr!=null&&(spr.cell??0)>0&&(spr.w??0)>0
component Rule(){
Spacer{height:1;fill:width;background:alpha(muted,0.25)}
}
component Crest(logo=null,art=null,px=16,name=""){
Box{
size:px
radius:px>20?6:4
background:alpha(muted,0.18)
clip:true
let si=logo==null||lowData?-1:(sprOk?get(spr.idx??{},logo,-1):-1)
if art{
Image{src:art;size:px;fit:contain;label:name}
}else if si>=0{
Canvas{
size:px
let sc=px/spr.cell
let cc=si%spr.cols
let rr=floor(si/spr.cols)
clip(0,0,px,px){image(sprPath,0-cc*px,0-rr*px,spr.w*sc,spr.h*sc)}
}
}else if logo&&!lowData{
Image{src:"~/.cache/espn-logos/soccer/${logo}";size:px;fit:contain;label:name}
}else if logo||lowData{
Text{text:name==""?"":sub(name,0,2);fontSize:max(px/3,8);align:center;color:soft;maxLines:1}
}else{
Box{size:px;radius:4;background:alpha(muted,0.18)}
}
}
}
component ZoneDot(c){
Box{width:8;height:8;radius:4;background:c=='green'?"#22c55e":c=='blue'?"#3b82f6":c=='orange'?"#f59e0b":c=='red'?"#ef4444":rgb(0,0,0,0)}
}
component TableRow(tm){
let ours=tm.ours!=null
Row{
gap:wide?4:2
align:center
Box{width:3;height:14;radius:1.5;background:tm.zone=='green'?"#22c55e":tm.zone=='blue'?"#3b82f6":tm.zone=='orange'?"#f59e0b":tm.zone=='red'?"#ef4444":rgb(0,0,0,0)}
Text{text:tm.rank;width:wide?20:10;fontSize:wide?fz:fz-2;color:soft;align:end;maxLines:1}
Text{text:wide?tm.name:tm.abbr;weight:1;fontSize:wide?fz:fz-2;maxLines:1;bold:ours;color:ours?pop:foreground}
if wide||cbMode{
Text{text:tm.zlabel??"";style:label;color:soft;width:wide?46:22;maxLines:1}
}
Text{text:tm.played;width:wide?20:10;fontSize:wide?fz:fz-2;color:soft;align:end;maxLines:1}
Text{text:tm.won;width:wide?18:9;fontSize:wide?fz:fz-2;color:soft;align:end;maxLines:1}
Text{text:tm.drawn;width:wide?18:9;fontSize:wide?fz:fz-2;color:soft;align:end;maxLines:1}
Text{text:tm.lost;width:wide?18:9;fontSize:wide?fz:fz-2;color:soft;align:end;maxLines:1}
if wide{
Text{text:tm.bp==null?"–":"${tm.bp}:${tm.bc}";width:40;fontSize:fz;color:soft;align:end;maxLines:1}
}
Text{text:tm.gd>0?"+${tm.gd}":"${tm.gd}";width:wide?26:18;fontSize:wide?fz:fz-2;color:soft;align:end;maxLines:1}
Text{text:tm.pts;width:wide?28:17;fontSize:wide?fz:fz-2;bold:true;align:end;maxLines:1}
}
}
component TableBlock(u){
Rule{}
Text{text:u.tag;style:title;maxLines:1}
if startsWith(u.group,"Group"){
Text{text:lang=="fr"?replace(u.group,"Group","Groupe"):u.group;style:small;color:soft}
}else if u.group=="League Phase"{
Text{text:lang=="fr"?"phase de ligue":"League phase";style:small;color:soft}
}
Row{
gap:wide?4:2
align:center
Box{width:3;height:10;background:rgb(0,0,0,0)}
Text{text:"#";width:wide?20:10;style:label;color:soft;align:end}
Text{text:S.team;weight:1;style:label;color:soft;maxLines:1}
Text{text:S.playedHdr;width:wide?20:10;style:label;color:soft;align:end}
Text{text:S.wHdr;width:wide?18:9;style:label;color:soft;align:end}
Text{text:S.dHdr;width:wide?18:9;style:label;color:soft;align:end}
Text{text:S.lHdr;width:wide?18:9;style:label;color:soft;align:end}
if wide{
Text{text:S.bfHdr;width:40;style:label;color:soft;align:end}
}
Text{text:S.gdHdr;width:wide?26:18;style:label;color:soft;align:end}
Text{text:S.pts;width:wide?28:17;style:label;color:soft;align:end}
}
for tm in u.teams key (tm.abbr??"")+":"+((tm.rank??0)+""){TableRow{tm:tm}}
if count(u.legend??[])>0{
Flow{
gap:8
for z in u.legend key z.c+z.t{
Row{
gap:4
align:center
ZoneDot{c:z.c}
Text{text:lang=="fr"?z.t:get(ENZ,z.t,z.t);style:label;color:soft}
}
}
}
}
}
component SetupBlock(){
let q=lower(trim(query))
let db=teamsDb.out??[]
let res=q==""?db.take(12):db.filter(t=>contains(lower(t.name),q)||contains(lower(t.short),q)||contains(lower(t.abbr),q)).take(12)
Column{
gap:8
Text{text:count(myTeams)==0?S.welcome:S.myTeamsT;style:title;align:center}
Text{text:S.trust;style:label;color:soft;align:center;maxLines:2}
Text{text:"${count(draft)}/5 — ${S.range}";style:small;color:soft;align:center}
Input{placeholder:S.searchClub;text:query;onChange:query=value}
if count(draft)>0{
Flow{
gap:6
for d in draft key d.key{
Text{text:"✕ ${d.short}";style:small;color:pop;onTap:draft=draft.filter(x=>x.key!=d.key)}
}
}
}
if count(draft)>=5{
Text{text:S.maxFiveHint;style:label;color:soft;align:center}
}
if teamsDb==null{
Text{text:S.loadingTeams;style:small;color:soft}
}else if !(teamsDb.ok??true){
Text{text:S.sourceErr+" "+(teamsDb.code??"");style:small;color:"#ef4444";align:center}
Button{text:S.retry;color:soft;onTap:refresh()}
}else if count(res)==0{
Text{text:S.noTeams+(q==""?"":" · "+S.searchHint);style:small;color:soft;align:center;maxLines:2}
if q!=""{Button{text:S.clearFilter;color:soft;onTap:query=""}}
}else{
for r in res key r.key{
let inD=draft.any(x=>x.key==r.key)
let full=count(draft)>=5&&!inD
Row{
gap:8
align:center
Crest{logo:r.logo;px:24;name:r.name??r.short??r.abbr}
Column{
weight:1;gap:0
Text{text:r.name;style:small;maxLines:1}
Text{text:r.tag;style:label;color:soft;maxLines:1}
}
Text{text:inD?"✓":"+";width:40;align:center;fontSize:18;color:inD?pop:full?muted:foreground;onTap:draft=inD?draft.filter(x=>x.key!=r.key):full?draft:(draft+[r]).take(5)}
}
}
}
Row{
gap:8
if count(myTeams)>0{
Button{text:S.cancel;weight:1;color:soft;onTap:showTeams=false}
}
if count(draft)>=1&&count(draft)<=5{
Button{text:"${S.validate} (${count(draft)}/5)";weight:1;color:pop;onTap:{myTeams=draft;showTeams=false;team="ALL";selJ=-1;refresh()}}
}else{
Button{text:count(draft)==0?S.pickOne:S.maxBtn;weight:1;color:muted;onTap:notify(S.notifT,S.notifX)}
}
}
}
}
component FormChip(l,px=15){
Canvas{
width:px;height:px-1
rect(0,0,px,px-1,radius:px>12?3:2,fill:l==cW?alpha("#22c55e",0.16):l==cL?alpha("#ef4444",0.16):alpha(muted,0.24))
text(l,px/2,(px-1)/2,size:px>12?9:7,align:center,bold:true,color:l==cW?"#22c55e":l==cL?"#ef4444":soft)
}
}
component GameRow(g,compact=false){
let hm=g.home??{}
let aw=g.away??{}
let isLive=g.state=='in'
let final=g.state=='post'
let rd=get(rounds,g.id,"")
let anchor=get(anchors,g.league,null)
let aDay=anchor==null?0:floor(anchor.at/86400)
let aW=(aDay+3)%7
let aSat=aW>=4?aDay+(5-aW):aDay-(aW+2)
let fDay=floor(g.at/86400)
let fW=(fDay+3)%7
let fSat=fW>=4?fDay+(5-fW):fDay-(fW+2)
let est=rd==""&&g.state=='pre'&&(g.league=='fra.1'||g.league=='fra.2')&&anchor!=null&&(anchor.jn??0)>0?"${JP}${anchor.jn + floor((fSat + 5) / 7) - floor((aSat + 5) / 7)}":""
let rdt=rd!=""?rd:(g.round??0)>0?"${JP}${g.round}":est
let eurPos=indexOf(eurIds,g.id)+1
let eurJ=g.league=='uefa.europa'&&eurPos>0&&eurPos<=8?"${JP}${eurPos}":""
let euroH=(g.league=='uefa.champions'||g.league=='uefa.europa'||g.league=='uefa.europa.conf')?(get(histMap,g.league,[])??[]).find(h=>h.id==g.id):null
let euroR=euroH==null?0:(euroH.round??0)
let euroJ=euroR>0?"${JP}${euroR}":""
let stg=g.stage??""
let stgL=stg=='knockout-round-playoffs'?S.stgPO:stg=='round-of-16'?S.stg16:stg=='quarterfinals'?S.stgQF:stg=='semifinals'?S.stgSF:stg=='final'?S.stgF:""
let stgK=stgL!=""&&stg!="league-phase"?stgL:""
let rdt2=stgK!=""?stgK:euroJ!=""?euroJ:rdt!=""?rdt:eurJ!=""?eurJ:stgL
let hmOurs=favAbbrs.any(a=>a==hm.abbr)
let awOurs=favAbbrs.any(a=>a==aw.abbr)
let scored=(hm.score??null)!=null&&(aw.score??null)!=null
let res=final&&(hmOurs!=awOurs)&&scored?(hmOurs?(hm.winner?cW:aw.winner?cL:cN):(aw.winner?cW:hm.winner?cL:cN)):""
let hide=spoiler&&(g.state=="in"||g.state=="post")&&!revealed.any(x=>x==g.id)
let slot=fz
let cpc=fz*8/13
let mwid=(compact?116:124)+2*slot
let dayRel=fmtTime(g.at,"yyyy-MM-dd")==fmtTime(now,"yyyy-MM-dd")?S.dayToday:fmtTime(g.at,"yyyy-MM-dd")==fmtTime(now+86400,"yyyy-MM-dd")?S.dayTomorrow:""
let dstr=dayRel!=""?dayRel+" "+fmtTime(g.at,"HH:mm"):fmtTime(g.at,compact?"EEE d/MM":"EEE d MMM",null,lang)
let gdet=lower(g.detail??"")
let special=contains(gdet,"postpon")?S.postponed:contains(gdet,"cancel")?S.cancelled:contains(gdet,"susp")?S.suspended:""
let extraTag=contains(gdet,"aet")?"AET":(contains(gdet,"pen")?"PEN":"")
let dtw=len(dstr??"")*5.2+1
Row{
gap:2
align:center
Column{
width:22;gap:0
Text{text:g.tag;fontSize:11;color:soft;maxLines:1}
}
Crest{logo:hm.logo;px:16;name:hm.name??hm.abbr}
Text{text:hmOurs?(myTeams.find(t=>t.abbr==hm.abbr).short??hm.abbr):wide?hm.name:hm.abbr;fontSize:fz;weight:1;maxLines:1;bold:hmOurs;color:hmOurs?pop:final&&!hide&&aw.winner?soft:foreground}
if g.state=='pre'&&!compact{
Column{
width:mwid;gap:0;align:center
Text{text:(dayRel==""?"":dayRel+" · ")+(dayRel==""?fmtTime(g.at,"EEE d MMM HH:mm",null,lang):fmtTime(g.at,"HH:mm"));fontSize:fz;align:center;color:foreground;maxLines:1}
Text{text:special!=""?special:"("+S.inPrep+fmtDuration(max(g.at-now,0))+")";style:label;align:center;color:soft;maxLines:1}
}
}else if g.state=='pre'{
Text{text:special!=""?special:(dayRel==""?fmtTime(g.at,"EEE d/MM HH:mm",null,lang):dayRel+" · "+fmtTime(g.at,"HH:mm"));fontSize:fz;width:mwid;align:center;color:soft;maxLines:1}
}else if final{
Row{
width:mwid;gap:1;align:center;justify:center
Box{width:slot;height:slot-1
if hmOurs&&res!=""&&!hide{
FormChip{l:res;px:fz}
}
}
Text{text:hide?"–":(hm.score??"?");fontSize:fz;font:mono;width:len((hm.score??"?")+"")*cpc;bold:!hide&&hm.winner;color:foreground;onTap:{revealed=(revealed+[g.id]).take(30)}}
Text{text:dstr;style:label;width:dtw;align:center;color:soft;maxLines:1}
Text{text:hide?"–":(aw.score??"?");fontSize:fz;font:mono;width:len((aw.score??"?")+"")*cpc;bold:!hide&&aw.winner;color:foreground;onTap:{revealed=(revealed+[g.id]).take(30)}}
Box{width:slot;height:slot-1
if awOurs&&res!=""&&!hide{
FormChip{l:res;px:fz}
}
}
}
}else{
Row{
width:mwid;gap:2;align:center;justify:center
Text{text:hide?"–":(hm.score??"?");fontSize:fz;font:mono;width:max(18,len((hm.score??"?")+"")*cpc);align:end;bold:!hide&&hmOurs&&isLive;color:hide?soft:isLive?"#22c55e":foreground;onTap:{revealed=(revealed+[g.id]).take(30)}}
Box{width:6;height:6;radius:3;background:isLive?"#22c55e":rgb(0,0,0,0)}
Text{text:isLive?S.liveWord+" "+g.detail:g.detail;style:label;width:max(38,fz*3);align:center;color:isLive?"#22c55e":soft;maxLines:1}
Box{width:6}
Text{text:hide?"–":(aw.score??"?");fontSize:fz;font:mono;width:max(18,len((aw.score??"?")+"")*cpc);align:start;bold:!hide&&awOurs&&isLive;color:hide?soft:isLive?"#22c55e":foreground;onTap:{revealed=(revealed+[g.id]).take(30)}}
}
}
Text{text:awOurs?(myTeams.find(t=>t.abbr==aw.abbr).short??aw.abbr):wide?aw.name:aw.abbr;fontSize:fz;weight:1;maxLines:1;align:end;bold:awOurs;color:awOurs?pop:final&&!hide&&hm.winner?soft:foreground}
Crest{logo:aw.logo;px:16;name:aw.name??aw.abbr}
Text{text:extraTag==""?rdt2:extraTag+" · "+rdt2;fontSize:11;color:soft;width:max(30,fz*2);align:end;maxLines:1}
}
}
component LiveGame(g,compact=false){
let lv=liveList.find(h=>h.id==g.id)??g
GameRow{g:lv;compact:compact}
}
component FormStrip(t,px=15){
let ms=all.filter(g=>g.state=="post"&&(t.kind??"c")==(g.league=="uefa.nations"||g.league=="fifa.worldq.uefa"||g.league=="fifa.friendly"?"n":"c")&&(count(g.tids??[])>0?((t.tid??"")!=""?(g.tids??[]).any(s=>s==t.tid):false):(g.squads??[]).any(s=>s==t.abbr))).sortBy(g=>-g.at).take(5).reverse()
Row{
width:5*px+8
gap:2
align:center
for g in ms key g.id{
let oh=(g.home.abbr??"")==t.abbr
let r=oh?(g.home.winner?cW:g.away.winner?cL:cN):(g.away.winner?cW:g.home.winner?cL:cN)
FormChip{l:r;px:px}
}
}
}
component BannerForm(t,lg,px=11){
let nat=lg=="uefa.nations"||lg=="fifa.worldq.uefa"||lg=="fifa.friendly"
let al=all.filter(g=>g.state=="post"&&((g.league=="uefa.nations"||g.league=="fifa.worldq.uefa"||g.league=="fifa.friendly")==nat)&&((g.home.abbr??"")==t.abbr||(g.away.abbr??"")==t.abbr)).map(g=>{id:g.id,at:g.at,home:g.home.abbr,away:g.away.abbr,hw:g.home.winner,aw:g.away.winner})
let hl=(get(histMap,lg,[])??[]).filter(g=>g.state=="post"&&((g.home.abbr??"")==t.abbr||(g.away.abbr??"")==t.abbr)).map(g=>{id:g.id,at:g.at,home:g.home.abbr,away:g.away.abbr,hw:g.home.winner,aw:g.away.winner})
let ms=flatten([al,hl.filter(g=>!al.any(a=>a.id==g.id))]).sortBy(g=>-g.at).take(5).reverse()
Column{
width:px
gap:2
align:center
for g in ms key g.id{
let oh=g.home==t.abbr
let r=oh?(g.hw?cW:g.aw?cL:cN):(g.aw?cW:g.hw?cL:cN)
FormChip{l:r;px:px}
}
}
}
component BannerLogo(logo=null,px=56,name=""){
Box{
size:px
fill:false
clip:true
background:rgb(0,0,0,0)
if !lowData&&logo!=null&&logo!=""{
Image{src:"~/.cache/espn-logos/banner/${logo}";width:px;height:px;fit:contain;label:name}
}else{
Text{text:name==""?"":sub(name,0,2);fontSize:max(px/4,9);align:center;color:soft;maxLines:1}
}
}
}
component BannerOdd(l,v,tone=soft){
Box{
weight:1
padding:[4,2]
radius:4*corners
background:alpha(tone,0.14)
Row{
gap:4
align:center
justify:center
Text{text:l;width:12;style:label;color:tone;maxLines:1}
Text{text:v==null?"—":"${fixed(v, 2)}";fontSize:fz;font:mono;bold:true;color:tone;maxLines:1}
}
}
}
component MatchBanner(w=72,h=96){
let ht=heroMatch==null||heroMatch.home==null||heroMatch.away==null?null:first(myTablesAll.filter(u=>u.league==heroMatch.league&&(u.teams??[]).any(tm=>tm.abbr==heroMatch.home.abbr)&&(u.teams??[]).any(tm=>tm.abbr==heroMatch.away.abbr)))
let hRow=ht==null?null:first((ht.teams??[]).filter(tm=>tm.abbr==heroMatch.home.abbr))
let aRow=ht==null?null:first((ht.teams??[]).filter(tm=>tm.abbr==heroMatch.away.abbr))
let hRank=hRow==null?null:hRow.rank
let aRank=aRow==null?null:aRow.rank
let od=heroMatch==null?null:((oddsNow??{}).id==heroMatch.id?oddsNow.odds:((heroOdds??{}).id==heroMatch.id?heroOdds.odds:heroMatch.odds))
let oh=od==null?null:od.h
let odr=od==null?null:od.d
let oa=od==null?null:od.a
let oddsOn=showOdds&&heroMatch!=null&&heroMatch.state=="pre"&&oh!=null&&odr!=null&&oa!=null
let midW=wide?fz*14:fz*13
let hOurs=heroMatch!=null&&(myTeams??[]).any(t=>t.abbr==heroMatch.home.abbr)
let aOurs=heroMatch!=null&&(myTeams??[]).any(t=>t.abbr==heroMatch.away.abbr)
let winC="#22c55e"
let drawC="#f59e0b"
let lossC="#ef4444"
let hTone=hOurs?winC:aOurs?lossC:soft
let dTone=hOurs||aOurs?drawC:soft
let aTone=aOurs?winC:hOurs?lossC:soft
if heroMatch!=null{
Box{fill:width;padding:[10,8];radius:8*corners;border:1;borderColor:accent;background:alpha(accent,0.18);onTap:{showDetail=true;previewTab="overview";screen()}
Row{gap:8;align:center;fill:width
if showForm{BannerForm{t:heroMatch.home;lg:heroMatch.league}}
Column{weight:1;gap:1;align:center
BannerLogo{logo:heroHLogo;px:56;name:heroH}
Text{text:heroH;bold:true;fontSize:fz;align:center;maxLines:1}
Text{text:hRank==null?"":"#${hRank}";style:label;color:soft;align:center;maxLines:1}
}
Column{width:midW;gap:1;align:center
Text{text:heroTime;style:title;align:center;maxLines:1}
Text{text:heroTagLine;style:label;color:soft;align:center;maxLines:1}
Text{text:heroDown;style:label;color:heroMatch.state=="in"?"#22c55e":accent;align:center;maxLines:1}
if oddsOn{
Row{
width:midW
padding:[3,2]
gap:2
align:center
radius:5*corners
background:alpha(background,0.5)
border:1
borderColor:alpha(accent,0.25)
BannerOdd{l:"1";v:oh;tone:hTone}
BannerOdd{l:"N";v:odr;tone:dTone}
BannerOdd{l:"2";v:oa;tone:aTone}
}
}
if heroH2H!=""{
Text{text:heroH2H;style:label;color:soft;align:center;maxLines:1}
}
if heroH2HLast!=""{
Text{text:heroH2HLast;style:label;color:soft;align:center;maxLines:1}
}
if noVigTxt!=""{Text{text:noVigTxt;style:label;color:soft;align:center;maxLines:1}}
if moveTxt!=""{Text{text:moveTxt;style:label;color:soft;align:center;maxLines:1}}
}
Column{weight:1;gap:1;align:center
BannerLogo{logo:heroALogo;px:56;name:heroA}
Text{text:heroA;bold:true;fontSize:fz;align:center;maxLines:1}
Text{text:aRank==null?"":"#${aRank}";style:label;color:soft;align:center;maxLines:1}
}
if showForm{BannerForm{t:heroMatch.away;lg:heroMatch.league}}
}
}
}
}
onTap:{showDetail=false;screen()}
Column{
scroll:true
Row{
gap:4
align:center
for m in modeTabs key m.id{
Text{text:m.short;weight:1;align:center;style:label;maxLines:1;color:view==m.id?pop:soft;bold:view==m.id;onTap:{view=m.id;selJ=-1}}
}
}
if liveBadge!=""{
Text{text:liveBadge;style:label;color:count(liveF)>0?"#22c55e":soft;align:center;maxLines:1}
}
if filterOn{
Text{text:S.filter+" : "+filterLabel+" ✕";style:label;color:pop;align:center;maxLines:1;onTap:{todayOnly=false;daySel=""}}
}
if compactMode||matchdayMode{
Text{text:(compactMode?S.compact:S.matchday)+" ✕";style:label;color:pop;align:center;maxLines:1;onTap:{compactMode=false;matchdayMode=false}}
}
if matchdayMode&&matchday{
Text{text:"⚽ "+S.matchday+(heroMatch==null?"":" · "+heroDown);style:label;color:pop;align:center;maxLines:1}
}
Rule{}
if healthTxt!=""&&!setupNeeded{
Text{text:healthShort;padding:4;style:label;color:"#ef4444";align:center;maxLines:1;onTap:screen()}
}
if view=="TOP5"{
Row{
gap:4
align:center
for lg in topTabs key lg.id{
Text{text:lg.short;weight:1;align:center;style:label;maxLines:1;color:topLg==lg.id?pop:soft;bold:topLg==lg.id;onTap:{topLg=topLg==lg.id?"ALL":lg.id;selJ=-1}}
}
}
}else if view=="EUROPE"{
Row{
gap:4
align:center
for lg in euroTabs key lg.id{
Text{text:lg.short;weight:1;align:center;style:label;maxLines:1;color:euroLg==lg.id?pop:soft;bold:euroLg==lg.id;onTap:{euroLg=lg.id;selJ=-1}}
}
}
}else{
Row{
gap:4
align:center
for t in myTeams key t.key{
Box{
weight:1
align:center
padding:3
border:2
radius:8
borderColor:team==t.abbr?(teamColors?hsl(hash(t.abbr)*360,0.65,0.55):pop):rgb(0,0,0,0)
background:team==t.abbr?alpha(accent,0.15):rgb(0,0,0,0)
onTap:{team=team==t.abbr?"ALL":t.abbr;selJ=-1}
Column{
gap:3
align:center
Crest{logo:t.logo;px:26;name:t.name??t.short??t.abbr}
if showForm{FormStrip{t:t;px:count(myTeams)>3?11:15}}
}
}
}
}
}
Rule{}
if count(myTeams)==0{
Button{text:S.chooseTeams;fill:width;color:pop;onTap:{showTeams=true;screen()}}
Rule{}
}
if view=="MINE"{
MatchBanner{w:wide?88:48;h:wide?88:64}
Column{
if games==null{
Text{text:S.loading;style:small;color:soft}
}else if gamesErr{
Text{text:S.sourceErr+" "+(games.code??"");style:small;color:"#ef4444";align:center}
}else if total==0&&(extraErr||seasonAllErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if total==0&&filterOn{
Text{text:S.noMatchDay+" · "+S.clearFilter;style:small;color:pop;align:center;maxLines:2;onTap:{todayOnly=false;daySel=""}}
}else if total==0{
Text{text:S.noMatchTeam;style:small;color:soft}
}else{
if count(pastTake)>0{
Text{text:S.recent+(count(pastA)>count(pastTake)?" +"+(count(pastA)-count(pastTake)):"");style:label;color:soft;align:center;maxLines:1;onTap:screen()}
for g in pastTake key g.id{LiveGame{g:g;compact:true}}
Rule{}
}
if count(upShow)>0{
Text{text:(count(liveF)>0?S.upLive:S.upcoming)+(count(upShow)>count(upTile)?" +"+(count(upShow)-count(upTile)):"");style:label;color:pop;align:center;onTap:screen()}
for g in upTile key g.id{LiveGame{g:g;compact:true}}
}
}
}
}else if view=="RIV"{
Column{
Text{text:rivLabel+liveWarn;style:label;color:soft;align:center;maxLines:1}
if extra==null&&nextup==null{
Text{text:S.loading;style:small;color:soft}
}else if extraErr&&nextErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(rivalsTile)==0&&(extraErr||nextErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(rivalsTile)==0{
Text{text:S.noRecent;style:small;color:soft}
}else{
for g in rivalsTile key g.id{LiveGame{g:g;compact:true}}
}
}
}else if view=="EUROPE"{
Column{
Text{text:euroLabel+liveWarn;style:label;color:soft;align:center;maxLines:1}
if extra==null&&nextup==null&&histfull==null{
Text{text:S.loading;style:small;color:soft}
}else if extraErr&&nextErr&&histErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if euroCurJ!=null&&euroMaxJ!=null{
if euroHero!=null{
LiveGame{g:euroHero;compact:true}
Rule{}
}
Row{
gap:4
align:center
Text{text:S.prev;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:euroCurJ!=null&&euroMinJ!=null&&euroCurJ>euroMinJ?foreground:muted;onTap:selJ=euroCurJ-1}
Text{text:euroCurJ==null?"…":"${JP}${euroCurJ} → ${JP}${euroUpJ}";weight:1;style:label;align:center;maxLines:1;color:selJ<0?pop:soft;onTap:selJ=-1}
Text{text:S.nextBtn;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:euroCurJ!=null&&euroMaxJ!=null&&euroCurJ<euroMaxJ?foreground:muted;onTap:selJ=euroCurJ+1}
}
Rule{}
if count(euroUpMatches)==0{
Text{text:euroCurJ!=null&&euroMaxPlayed!=null&&euroCurJ>=euroMaxJ?S.seasonOver:S.noUpcoming;style:small;color:soft;align:center}
}else{
for g in euroUpMatches key g.id{LiveGame{g:g;compact:true}}
}
Rule{}
Text{text:"· ${JP}${euroCurJ} ·";style:label;color:pop;align:center}
if count(euroResMatches)==0{
Text{text:S.noResults;style:small;color:soft;align:center}
}else{
for g in euroResMatches key g.id{LiveGame{g:g;compact:true}}
}
}else if count(euroList)==0&&(extraErr||nextErr||histErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(euroList)==0{
Text{text:S.noRecent;style:small;color:soft}
}else{
for g in euroList key g.id{LiveGame{g:g;compact:true}}
}
}
}else{
Column{
Text{text:(topLg=="ALL"?topLabel:topLabel+" · "+S.tapAll)+liveWarn;style:label;color:topLg=="ALL"?soft:pop;align:center;maxLines:1;onTap:topLg="ALL"}
if extra==null&&nextup==null&&histfull==null{
Text{text:S.loading;style:small;color:soft}
}else if extraErr&&nextErr&&histErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if curLg!=null&&maxJ!=null&&curJ!=null{
if topHero!=null{
LiveGame{g:topHero;compact:true}
Rule{}
}
Row{
gap:4
align:center
Text{text:S.prev;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:curJ!=null&&minJ!=null&&curJ>minJ?foreground:muted;onTap:selJ=curJ-1}
Text{text:curJ==null?"…":"${JP}${curJ} → ${JP}${topUpJ}";weight:1;style:label;align:center;maxLines:1;color:selJ<0?pop:soft;onTap:selJ=-1}
Text{text:S.nextBtn;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:curJ!=null&&maxJ!=null&&curJ<maxJ?foreground:muted;onTap:selJ=curJ+1}
}
Rule{}
if count(topUpMatches)==0{
Text{text:curJ!=null&&maxPlayed!=null&&curJ>=maxJ?S.seasonOver:S.noUpcoming;style:small;color:soft;align:center}
}else{
for g in topUpMatches key g.id{LiveGame{g:g;compact:true}}
}
Rule{}
Text{text:"· ${JP}${curJ} ·";style:label;color:pop;align:center}
if count(topResMatches)==0{
Text{text:S.noResults;style:small;color:soft;align:center}
}else{
for g in topResMatches key g.id{LiveGame{g:g;compact:true}}
}
}else if count(topTile)==0&&(extraErr||nextErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(topTile)==0{
Text{text:S.noRecent;style:small;color:soft}
}else{
for g in topTile key g.id{LiveGame{g:g;compact:true}}
}
}
}
}
component PreviewStat(l,v){
Column{
weight:1
gap:2
padding:6
radius:6*corners
background:alpha(accent,0.08)
border:1
borderColor:alpha(accent,0.18)
Text{text:v;style:title;bold:true;color:pop;align:center;maxLines:1}
Text{text:l;style:small;color:soft;align:center;maxLines:1}
}
}
component PreviewSpark(vals){
Canvas{
width:170;height:34
let n=count(vals)
let mx=max(n-1,1)
let pts=range(n).map(i=>[6+i*(158/mx),28-(vals[i]??0)/3*20])
line(6,28,164,28,stroke:alpha(muted,0.35),width:1)
if count(pts)>1{path(pts,stroke:pop,width:2.5,cap:round)}
}
}
component MatchPage(){
Column{
gap:10
Row{gap:6;align:center
Button{text:"‹ "+S.close;color:soft;padding:8;onTap:{showDetail=false;close()}}
Column{weight:1;gap:1;align:center
Text{text:S.preview;style:title;bold:true;align:center;maxLines:1}
Text{text:heroTagLine;style:small;color:soft;align:center;maxLines:1}
if heroH2HObj!=null&&heroH2HObj.ts!=null{Text{text:(lang=="fr"?"maj ":"updated ")+fmtAgo(heroH2HObj.ts,now);style:label;color:soft;align:center;maxLines:1}}
}
Button{text:S.copyPreviewT;color:soft;onTap:copy(heroShare)}
}
Row{gap:8;align:center
Column{weight:1;align:center;gap:1
BannerLogo{logo:heroHLogo;px:64;name:heroH}
Text{text:heroH;bold:true;fontSize:fz+1;align:center;maxLines:1}
Text{text:heroHomeRow==null?"":"#"+heroHomeRow.rank;style:label;color:soft;align:center;maxLines:1}
Text{text:S.formHomeShort+" "+(previewHeroHomeForm==""?"—":previewHeroHomeForm);style:label;color:soft;align:center;maxLines:1}
}
Column{width:wide?180:150;align:center;gap:2
Text{text:heroTime;style:title;align:center;maxLines:1}
Text{text:heroDay;style:small;color:soft;align:center;maxLines:1}
Text{text:heroDown;style:label;color:heroMatch!=null&&heroMatch.state=="in"?"#22c55e":accent;align:center;maxLines:1}
if od1!=null{Row{gap:2;align:center
BannerOdd{l:"1";v:od1.h}
BannerOdd{l:"N";v:od1.d}
BannerOdd{l:"2";v:od1.a}
}}
}
Column{weight:1;align:center;gap:1
BannerLogo{logo:heroALogo;px:64;name:heroA}
Text{text:heroA;bold:true;fontSize:fz+1;align:center;maxLines:1}
Text{text:heroAwayRow==null?"":"#"+heroAwayRow.rank;style:label;color:soft;align:center;maxLines:1}
Text{text:S.formAwayShort+" "+(previewHeroAwayForm==""?"—":previewHeroAwayForm);style:label;color:soft;align:center;maxLines:1}
}
}
if previewRest!=null{Text{text:S.restT+" · "+previewRest+(lang=="fr"?" j":" d")+" · "+S.importanceT+" · "+previewImportance;style:small;color:soft;align:center;maxLines:1}}
Row{gap:4
for tab in previewTabs.take(4) key tab.id{Button{text:tab.short;weight:1;padding:6;color:previewTab==tab.id?pop:soft;onTap:previewTab=tab.id}}
}
Row{gap:4
for tab in previewTabs.drop(4) key tab.id{Button{text:tab.short;weight:1;padding:6;color:previewTab==tab.id?pop:soft;onTap:previewTab=tab.id}}
}
if previewTab=="overview"{
Column{gap:8
Row{gap:6
PreviewStat{l:S.rankT;v:heroHomeRow==null?"—":"#"+heroHomeRow.rank}
PreviewStat{l:S.ppgT;v:previewPPG}
PreviewStat{l:S.projT;v:previewProjection}
}
if count(previewKeys)>0{
Text{text:S.keysT;style:label;color:pop}
for k in previewKeys key k{Text{text:"· "+k;style:small;color:soft;maxLines:2}}
}
Text{text:S.formHomeT+" · "+(previewHomeForm==""?"—":previewHomeForm)+" · "+S.formAwayT+" · "+(previewAwayForm==""?"—":previewAwayForm);style:small;color:soft;maxLines:1}
if count(previewPoints)>0{Row{gap:8;align:center
Text{text:S.momentumT;style:label;color:soft;maxLines:1}
PreviewSpark{vals:previewPoints}
}}
if count(previewGames.take(5))>0{
Text{text:S.last5T;style:label;color:pop}
for g in previewGames.take(5) key g.id{LiveGame{g:g;compact:true}}
}
Text{text:S.next5T+((previewNextAvg=="—")?"":" · "+S.avgRankT+" #"+previewNextAvg);style:label;color:pop}
if count(previewNext)==0{Text{text:S.noDataT;style:small;color:soft}}
else{for g in previewNext key g.id{LiveGame{g:g;compact:true}}}
}
}
if previewTab=="odds"{
Column{gap:8
if od1==null{Text{text:S.noDataT;style:small;color:soft}}
else{
Row{gap:6
BannerOdd{l:"1";v:od1.h}
BannerOdd{l:"N";v:od1.d}
BannerOdd{l:"2";v:od1.a}
}
if noVigTxt!=""{Text{text:noVigTxt;style:small;color:foreground;align:center;maxLines:1}}
if moveTxt!=""{Text{text:moveTxt;style:small;color:soft;align:center;maxLines:1}}
if od1.tot!=null{Text{text:S.totalT+" · "+fixed(od1.tot,1)+" · "+(od1.tov==null?"—":fixed(od1.tov,2))+" / "+(od1.tuv==null?"—":fixed(od1.tuv,2));style:small;color:soft;align:center;maxLines:1}}
if od1.sph!=null{Text{text:S.handicapT+" · "+fixed(od1.sph,1)+" / "+(od1.spa==null?"—":fixed(od1.spa,1));style:small;color:soft;align:center;maxLines:1}}
Text{text:S.previewHint;style:label;color:soft;align:center;maxLines:2}
if heroMatch!=null&&heroMatch.aggH!=null&&heroMatch.aggA!=null{Text{text:S.agg+heroMatch.aggH+"–"+heroMatch.aggA;style:small;color:soft;align:center}}
}
}
}
if previewTab=="stats"{
Column{gap:8
if heroHomeRow==null&&heroAwayRow==null{Text{text:S.noDataT;style:small;color:soft}}
else{
Row{gap:4
Text{text:heroH;weight:1;bold:true;color:pop;maxLines:1}
Text{text:"#"+ (heroHomeRow==null?"—":heroHomeRow.rank)+"  #"+(heroAwayRow==null?"—":heroAwayRow.rank);style:small;color:soft;maxLines:1}
Text{text:heroA;weight:1;bold:true;color:pop;align:end;maxLines:1}
}
Row{gap:4
Text{text:heroHomeRow==null?"—":heroHomeRow.pts+" pts · "+heroHomeRow.played+" J";style:small;color:soft;weight:1;maxLines:1}
Text{text:heroAwayRow==null?"—":heroAwayRow.pts+" pts · "+heroAwayRow.played+" J";style:small;color:soft;weight:1;align:end;maxLines:1}
}
Text{text:S.compareT;style:label;color:pop}
Row{gap:4
Text{text:S.goalsT;style:small;color:soft;width:90}
Text{text:heroH+" · "+previewHTeamGF+" / "+previewHTeamGA;style:small;color:foreground;weight:1;align:center;maxLines:1}
Text{text:heroA+" · "+previewATeamGF+" / "+previewATeamGA;style:small;color:foreground;weight:1;align:center;maxLines:1}
}
Row{gap:4
Text{text:S.pts5T;style:small;color:soft;width:90}
Text{text:heroH+" · "+previewHTeamPts;style:small;color:foreground;weight:1;align:center;maxLines:1}
Text{text:heroA+" · "+previewATeamPts;style:small;color:foreground;weight:1;align:center;maxLines:1}
}
Row{gap:4
Text{text:S.cleanT;style:small;color:soft;width:90}
Text{text:heroH+" · "+previewHTeamClean;style:small;color:foreground;weight:1;align:center;maxLines:1}
Text{text:heroA+" · "+previewATeamClean;style:small;color:foreground;weight:1;align:center;maxLines:1}
}
Row{gap:4
Text{text:S.bttsT;style:small;color:soft;width:90}
Text{text:heroH+" · "+previewHTeamBTTS;style:small;color:foreground;weight:1;align:center;maxLines:1}
Text{text:heroA+" · "+previewATeamBTTS;style:small;color:foreground;weight:1;align:center;maxLines:1}
}
}
Row{gap:6
PreviewStat{l:S.goalsT;v:previewGF+" / "+previewGA}
PreviewStat{l:S.cleanT;v:previewClean}
PreviewStat{l:S.bttsT;v:previewBTTS}
PreviewStat{l:S.overT;v:previewOver}
}
if count(heroH2HObj.stats??[])>0{
Text{text:S.statsT;style:label;color:pop}
Row{gap:8
for side in (heroH2HObj.stats??[]) key side.team{
Column{weight:1;gap:2
Text{text:side.team;style:label;color:soft;align:center}
for st in (side.st??[]) key st.l{Row{gap:4 Text{text:st.l;style:label;color:soft;weight:1;maxLines:1} Text{text:st.v;style:label;color:foreground;maxLines:1}}}
}
}
}
if count(heroH2HObj.leaders??[])>0{
Text{text:S.leadersT;style:label;color:pop}
for ld in (heroH2HObj.leaders??[]) key ld.t+ld.n{Text{text:ld.t+" · "+(ld.n??"")+(count(ld.l??[])>0?": "+join((ld.l??[]).map(x=>x.n+" "+x.v)," · "):"");style:label;color:soft;maxLines:2}}
}
if count(heroH2HObj.injuries??[])>0{
Text{text:S.injuriesT;style:label;color:pop}
for it in (heroH2HObj.injuries??[]) key it.t+it.n{Text{text:it.t+" · "+(it.n??"")+(it.s==null?"":" · "+(it.s??""))+(it.d==null?"":" · "+(it.d??""));style:label;color:soft;maxLines:1}}
}
if count(heroH2HObj.events??[])>0{
Text{text:S.timeline;style:label;color:pop}
for e in (heroH2HObj.events??[]) key e.m+e.x{Text{text:e.m+" · "+e.x;style:label;color:soft;maxLines:2}}
}
}
}
}
if previewTab=="h2h"{
Column{gap:8
if heroH2HObj==null||heroH2HObj.h2h==null{Text{text:S.noDataT;style:small;color:soft}}
else{
Text{text:S.recordT+" · "+heroH2HObj.h2h.w+"V "+heroH2HObj.h2h.d+"N "+heroH2HObj.h2h.l+"D";style:title;align:center;color:pop;maxLines:1}
Text{text:S.goalsT+" · "+previewH2HGoals+" · "+previewH2HAvg+" / match · "+S.h2hAll;style:small;color:soft;align:center;maxLines:1}
for h in previewH2H key h.d+h.hs{Text{text:h.d+" · "+h.hs+"–"+h.a+(h.w?" ✓":"");style:label;color:soft;maxLines:1}}
}
}
}
if previewTab=="squads"{
Column{gap:8
Text{text:S.lineupsT;style:label;color:pop}
if count(heroH2HObj.lineups??[])==0{Text{text:S.noDataT;style:small;color:soft}}
else{for l in (heroH2HObj.lineups??[]) key l.t{Text{text:l.t+" "+(l.f??"")+" · "+join((l.p??[]).map(p=>p.n)," · ");style:label;color:soft;maxLines:3}}}
if count(heroH2HObj.leaders??[])>0{Text{text:S.leadersT;style:label;color:pop};for ld in (heroH2HObj.leaders??[]) key ld.t+ld.n{Text{text:ld.t+" · "+(ld.n??"")+": "+join((ld.l??[]).map(x=>x.n+" "+x.v)," · ");style:label;color:soft;maxLines:2}}}
if count(heroH2HObj.injuries??[])>0{Text{text:S.injuriesT;style:label;color:pop};for it in (heroH2HObj.injuries??[]) key it.t+it.n{Text{text:it.t+" · "+(it.n??"")+(it.s==null?"":" · "+(it.s??""));style:label;color:soft;maxLines:1}}}
}
}
if previewTab=="news"{
Column{gap:8
Text{text:S.newsT;style:label;color:pop}
if count(heroH2HObj.news??[])>0{
for n in (heroH2HObj.news??[]) key n.h{Text{text:n.h;style:label;color:pop;maxLines:2};Text{text:n.d;style:small;color:soft;maxLines:3}}
}else{Text{text:S.noDataT;style:small;color:soft}}
}
}
if previewTab=="travel"{
Column{gap:8
if hInfo.venue!=null{Text{text:S.venue+" · "+(hInfo.venue??"")+(hInfo.city==null?"":" · "+(hInfo.city??""));style:small;color:soft;maxLines:2}}
if hInfo.referee!=null{Text{text:S.referee+" · "+(hInfo.referee??"");style:small;color:soft;maxLines:1}}
Text{text:S.localTime+" · "+fmtTime(heroAt,"EEE d/MM HH:mm",null,lang);style:small;color:soft;maxLines:1}
if previewRest!=null{Text{text:S.restT+" · "+previewRest+(lang=="fr"?" j":" d");style:small;color:soft;maxLines:1}}
Row{gap:6
Button{text:S.travel;weight:1;color:soft;onTap:copy(travelTxt)}
Button{text:S.banter;weight:1;color:soft;onTap:copy(banterTxt)}
}
Row{gap:6
Button{text:S.pauseAlerts;weight:1;color:pauseUntil>now?"#ef4444":soft;onTap:pauseUntil=pauseUntil>now?0:now+86400}
if heroMyTeam!=null{Button{text:S.alerts+" : "+(muteTeams.any(a=>a==heroMyAbbr)?S.no:S.yes);weight:1;color:muteTeams.any(a=>a==heroMyAbbr)?"#ef4444":soft;onTap:muteTeams=muteTeams.any(a=>a==heroMyAbbr)?muteTeams.filter(a=>a!=heroMyAbbr):(muteTeams+[heroMyAbbr])}}
}
Text{text:S.lead;style:label;color:soft}
Row{gap:4
for h in[1,3,6,12]key h{Button{text:"${h}h";weight:1;color:leadH==h?pop:soft;onTap:{leadH=h;refresh()}}}
}
}
}
Button{text:S.close;color:soft;onTap:{showDetail=false;close()}}
}
}

screen{
title:lang=="fr"?"mes matchs":"my matches"
Column{
scroll:true
gap:10
if showDetail{MatchPage{}}else{
Row{
gap:6
Text{text:statusTxt+liveSuffix;style:small;color:spinning?"#22c55e":lastOk==false?"#ef4444":soft;weight:1;maxLines:1}
Button{text:showSettings?S.close:S.settings;color:soft;onTap:showSettings=!showSettings}
}
if healthTxt!=""&&!setupNeeded{
Text{text:healthShort;style:small;color:"#ef4444";align:center;maxLines:1}
Text{text:offlineTxt+" · "+S.retry;style:small;color:"#ef4444";align:center;maxLines:1;onTap:refresh()}
}
if !showSettings{
Row{
gap:6
for m in modeTabs key m.id{
Button{text:m.short;weight:1;padding:6;color:view==m.id?pop:soft;onTap:{view=m.id;selJ=-1}}
}
}
Rule{}
if setupNeeded{
SetupBlock{}
}else{
Row{
gap:8
align:center
for t in myTeams key t.key{
Box{
weight:1
align:center
padding:3
border:2
radius:8
borderColor:team==t.abbr?(teamColors?hsl(hash(t.abbr)*360,0.65,0.55):pop):rgb(0,0,0,0)
background:team==t.abbr?alpha(accent,0.15):rgb(0,0,0,0)
onTap:{team=team==t.abbr?"ALL":t.abbr;selJ=-1}
Column{
gap:3
align:center
Crest{logo:t.logo;px:32;name:t.name??t.short??t.abbr}
if showForm{FormStrip{t:t;px:count(myTeams)>3?11:15}}
}
}
}
Column{
width:52;gap:0;align:center
Canvas{
width:52;height:52
onTap:{refresh();spinning=true;elapsed=0;lastOk=null;spinUntil=now+245;spinAt=now+1}
let mid=26
rect(1,1,50,50,radius:10,fill:spinning?alpha("#22c55e",0.12):rgb(0,0,0,0),stroke:spinning?"#22c55e":border,width:1)
if spinning{
text(["⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"][elapsed%10],mid,mid,size:22,align:center,color:"#22c55e")
}else if lastOk==true{
text("✓",mid,mid,size:22,align:center,color:"#22c55e")
}else if lastOk==false{
text("✗",mid,mid,size:22,align:center,color:"#ef4444")
}else{
text("↻",mid,mid,size:20,align:center,color:muted)
}
}
Text{text:S.refresh;style:label;color:soft;align:center;maxLines:1;onTap:{refresh();spinning=true;elapsed=0;lastOk=null;spinUntil=now+245;spinAt=now+1}}
}
}
}
if !setupNeeded{
Row{
gap:2
for c in cal key c.k{
Column{weight:1;align:center;onTap:daySel=(daySel==c.k?"":c.k)
Text{text:c.d;style:label;color:daySel==c.k?pop:soft;bold:daySel==c.k;maxLines:1}
Text{text:c.n;style:label;color:c.n>0?pop:soft;bold:c.n>0;maxLines:1}
}
}
}
}
Rule{}
if view=="TOP5"{
Row{
gap:6
for lg in topTabs key lg.id{
Button{text:lg.short;weight:1;color:topLg==lg.id?pop:soft;onTap:{topLg=topLg==lg.id?"ALL":lg.id;selJ=-1}}
}
}
}
if view=="EUROPE"{
Row{
gap:6
for lg in euroTabs key lg.id{
Button{text:lg.short;weight:1;color:euroLg==lg.id?pop:soft;onTap:{euroLg=lg.id;selJ=-1}}
}
}
}
Rule{}
}
if showSettings{
Column{
gap:8
Text{text:S.general;style:title}
Text{text:S.displaySize;style:label;color:soft}
Row{gap:6
for sz in["S","M","L","XL"]key sz{Button{text:sz;weight:1;color:uiSize==sz?pop:soft;onTap:uiSize=sz}}
}
Text{text:S.myTeamsT+" ("+count(myTeams)+"/5)";style:label;color:soft}
Text{text:count(myTeams)==0?S.nonePick:join(myTeams.map(t=>t.short)," · ");style:small;color:pop;maxLines:2;onTap:showTeams=true}
Button{text:S.editTeams;color:soft;onTap:showTeams=true}
Text{text:lang=="fr"?"Langue":"Language";style:label;color:soft}
Row{gap:6
Button{text:"English";weight:1;color:lang=="en"?pop:soft;onTap:lang="en"}
Button{text:"Français";weight:1;color:lang=="fr"?pop:soft;onTap:lang="fr"}
}
Rule{}
Text{text:S.affichage;style:title}
Row{gap:6 Text{text:S.spoiler;style:label;color:foreground;weight:1} Button{text:spoiler?S.yes:S.no;color:spoiler?pop:soft;onTap:spoiler=!spoiler}}
Row{gap:6 Text{text:S.hc;style:label;color:foreground;weight:1} Button{text:hcMode?S.yes:S.no;color:hcMode?pop:soft;onTap:hcMode=!hcMode}}
Row{gap:6 Text{text:S.teamColors;style:label;color:foreground;weight:1} Button{text:teamColors?S.yes:S.no;color:teamColors?pop:soft;onTap:teamColors=!teamColors}}
Row{gap:6 Text{text:S.lowData;style:label;color:foreground;weight:1} Button{text:lowData?S.yes:S.no;color:lowData?pop:soft;onTap:lowData=!lowData}}
Row{gap:6 Text{text:S.cb;style:label;color:foreground;weight:1} Button{text:cbMode?S.yes:S.no;color:cbMode?pop:soft;onTap:cbMode=!cbMode}}
Row{gap:6 Text{text:S.matchday;style:label;color:foreground;weight:1} Button{text:matchdayMode?S.yes:S.no;color:matchdayMode?pop:soft;onTap:matchdayMode=!matchdayMode}}
Row{gap:6 Text{text:S.compact;style:label;color:foreground;weight:1} Button{text:compactMode?S.yes:S.no;color:compactMode?pop:soft;onTap:compactMode=!compactMode}}
Row{gap:6 Text{text:S.todayOnly;style:label;color:foreground;weight:1} Button{text:todayOnly?S.yes:S.no;color:todayOnly?pop:soft;onTap:todayOnly=!todayOnly}}
Row{gap:6 Text{text:S.showOdds;style:label;color:foreground;weight:1} Button{text:showOdds?S.yes:S.no;color:showOdds?pop:soft;onTap:showOdds=!showOdds}}
Row{gap:6 Text{text:S.showForm;style:label;color:foreground;weight:1} Button{text:showForm?S.yes:S.no;color:showForm?pop:soft;onTap:showForm=!showForm}}
Rule{}
Text{text:S.rappels;style:title}
Text{text:S.lead;style:label;color:soft}
Row{gap:6
for h in[1,3,6,12,24]key h{Button{text:"${h}h";weight:1;color:leadH==h?pop:soft;onTap:{leadH=h;refresh()}}}
}
Row{gap:6 Text{text:S.quiet;style:label;color:foreground;weight:1} Text{text:"22–07";style:label;color:soft} Button{text:quietOn?S.yes:S.no;color:quietOn?pop:soft;onTap:quietOn=!quietOn}}
Row{gap:6 Text{text:S.digest;style:label;color:foreground;weight:1} Text{text:"08:00";style:label;color:soft} Button{text:digestOn?S.yes:S.no;color:digestOn?pop:soft;onTap:{digestOn=!digestOn;digestAt=0;refresh()}}}
Row{gap:6 Text{text:S.weekly;style:label;color:foreground;weight:1} Text{text:"lun.";style:label;color:soft} Button{text:weeklyOn?S.yes:S.no;color:weeklyOn?pop:soft;onTap:weeklyOn=!weeklyOn}}
Row{gap:6 Text{text:S.prewarm;style:label;color:foreground;weight:1} Text{text:"06:00";style:label;color:soft} Button{text:prewarmOn?S.yes:S.no;color:prewarmOn?pop:soft;onTap:{prewarmOn=!prewarmOn;prewarmAt=0;refresh()}}}
Row{gap:6 Text{text:S.pauseAlerts;style:label;color:foreground;weight:1} Button{text:pauseUntil>now?S.yes:S.no;color:pauseUntil>now?"#ef4444":soft;onTap:pauseUntil=pauseUntil>now?0:now+86400}}
Button{text:S.resetRem;fill:width;color:soft;onTap:{h12Id="";h12At=0;kickId="";kickAt=0;nextDone=[];kickDone=[];digestAt=0;revealed=[];refresh()}}
Rule{}
Text{text:S.partage;style:title}
Row{gap:6
Button{text:S.copyMatch;weight:1;color:soft;onTap:copy(heroShare)}
Button{text:S.copyTeams;weight:1;color:soft;onTap:copy(toJson(myTeams))}
}
Row{gap:6
Button{text:S.travel;weight:1;color:soft;onTap:copy(travelTxt)}
Button{text:S.banter;weight:1;color:soft;onTap:copy(banterTxt)}
}
Text{text:S.rivalsT;style:label;color:soft}
Input{placeholder:S.rivalsHint;text:rivalsCsv;onChange:rivalsCsv=value}
if count(rivalsList)>0{Text{text:join(rivalsList," · ");style:small;color:pop;maxLines:2}}
Text{text:S.alertsByClub;style:label;color:soft}
for t in myTeams key t.key{
Row{gap:6
Text{text:t.short??t.abbr;style:label;color:foreground;weight:1}
Button{text:muteTeams.any(a=>a==t.abbr)?S.no:S.yes;color:muteTeams.any(a=>a==t.abbr)?"#ef4444":soft;onTap:muteTeams=muteTeams.any(a=>a==t.abbr)?muteTeams.filter(a=>a!=t.abbr):(muteTeams+[t.abbr])}
}
}
Rule{}
Text{text:S.donnees;style:title}
Text{text:S.health+" : "+healthLine;style:label;color:healthTxt==""?soft:"#ef4444";maxLines:3}
Row{gap:6
Button{text:S.exportT;weight:1;color:soft;onTap:copy(archiveTxt)}
Button{text:S.diag;weight:1;color:soft;onTap:{copy("my-match v5.16.2\n"+healthLine);diagDone=true}}
}
Row{gap:6
Button{text:S.clearCaches;weight:1;color:soft;onTap:clearAsk=true}
}
if count(allMine)>0{Text{text:S.archiveT+" · "+count(allMine.filter(g=>g.state=="post"))+" matchs";style:label;color:soft;maxLines:1}}
if healthTxt!=""{Text{text:offlineTxt;style:label;color:"#ef4444";maxLines:1;onTap:refresh()}}
for h in healthList key h.n{
Row{gap:6
Text{text:get(healthLabel,h.n,h.n)+" "+(h.s==null?"…":(h.s.ok??false)?"✓":("✗"+(h.s.code??"")));style:label;color:healthBad.any(b=>b.n==h.n)?"#ef4444":soft;weight:1;maxLines:1}
Button{text:S.retry;color:soft;onTap:refresh()}
}
}
Text{text:S.importT;style:label;color:soft}
Input{placeholder:S.importHint;text:importRaw;onChange:importRaw=value}
Row{gap:6
Button{text:S.importT;weight:1;color:soft;onTap:{if importRaw!=""{let importedTeams=parseJson(importRaw);if count(importedTeams)>0{myTeams=importedTeams;importOk=true;refresh()}}}}
if importOk{Text{text:S.importOk;style:label;color:"#22c55e";maxLines:1}}
}
if diagDone{Text{text:S.diagDone;style:label;color:"#22c55e";align:center}}
if clearAsk{
Text{text:S.clearAsk;style:small;color:"#ef4444";align:center}
Row{gap:6
Button{text:S.yes;weight:1;color:"#ef4444";onTap:{run("rm -rf ~/.cache/espn-*");clearAsk=false;refresh()}}
Button{text:S.no;weight:1;color:soft;onTap:clearAsk=false}
}
}
Rule{}
Text{text:S.apropos;style:title}
Text{text:"my-match v5.16.2 · ESPN";style:label;color:soft;align:center;maxLines:1}
Text{text:S.dataBy;style:small;color:soft;maxLines:2}
}
}

if !showSettings{
if view=="MINE"{
MatchBanner{w:96;h:96}
if !lowData&&heroH2HObj!=null&&count(heroH2HObj.news??[])>0{
Text{text:S.newsT+" · "+(heroH2HObj.news[0].h??"");style:small;color:soft;align:center;maxLines:1;onTap:{showDetail=true;screen()}}
}
if filterOn&&count(baseF)==0{
Text{text:S.noMatchDay+" · "+S.clearFilter;style:small;color:pop;align:center;maxLines:2;onTap:{todayOnly=false;daySel=""}}
}
if count(upShow)>0{
Text{text:S.upcomingHdr;style:label;color:pop}
for g in upShow.take(8) key g.id{LiveGame{g:g}}
Rule{}
}
if count(cupStages)>0{
Text{text:S.bracket;style:label;color:pop}
for st in cupStages key st{
let sm=cupSource.filter(g=>(g.stage??"")==st).sortBy(g=>g.at)
Text{text:"${get(knockLabels,st,st)} · ${count(sm)}";style:small;color:soft}
for g in sm key g.id{LiveGame{g:g}}
}
Rule{}
}

}
if view=="RIV"{
Rule{}
Text{text:S.rivMatches;style:label;color:pop}
Text{text:rivLabel;style:small;color:soft}
if nextup==null{
Text{text:S.fixturesLoading;style:small;color:soft}
}else if nextErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(rivalsNext)>0{
Text{text:S.upcomingHdr;style:label;color:pop}
for g in rivalsNext key g.id{LiveGame{g:g}}
}
if extra==null{
Text{text:S.loading;style:body;color:soft}
}else if extraErr{
Text{text:S.sourceErr+" "+(extra.code??"");style:body;color:"#ef4444";align:center}
}else if curLg!=null&&maxJ!=null{
Row{
gap:6
Button{text:S.prev;width:56;padding:6;color:curJ!=null&&minJ!=null&&curJ>minJ?foreground:muted;onTap:selJ=curJ-1}
Button{text:curJ==null?"…":"${JP}${curJ} · ${count(jMatches)}";weight:1;color:selJ<0?pop:soft;onTap:selJ=-1}
Button{text:S.nextBtn;width:56;padding:6;color:curJ!=null&&maxJ!=null&&curJ<maxJ?foreground:muted;onTap:selJ=curJ+1}
}
if count(jMatches)==0{
Text{text:S.noMatchDay;style:body;color:soft}
}else{
for g in jMatches key g.id{LiveGame{g:g}}
}
}else if count(rivalsAll)==0&&(extraErr||nextErr){
Text{text:S.sourceErr;style:body;color:"#ef4444";align:center}
}else if count(rivalsAll)==0{
Text{text:S.noRecent;style:body;color:soft}
}else{
for g in rivalsAll.take(team=="ALL"?15:30)key g.id{LiveGame{g:g}}
}
if standings==null{
Text{text:S.standingsLoading;style:small;color:soft}
}else if !(standings.ok??true){
Text{text:S.sourceErr+" "+(standings.code??"");style:small;color:"#ef4444";align:center}
}else if count(myTables)==0{
Text{text:S.noStandings;style:small;color:soft}
}else{
Text{text:showTables?S.stOn:S.stOff;style:label;color:soft;align:center;onTap:showTables=!showTables}
if showTables{
for u in myTables key u.tag+" "+u.group{TableBlock{u:u}}
}
}
}else if view=="TOP5"{
Rule{}
Text{text:S.top5Matches;style:label;color:pop}
Text{text:topLabel+liveWarn;style:small;color:soft}
if nextup==null{
Text{text:S.fixturesLoading;style:small;color:soft}
}else if nextErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(topNext)>0{
Text{text:S.upcomingHdr;style:label;color:pop}
for g in topNext key g.id{LiveGame{g:g}}
}
if extra==null{
Text{text:S.loading;style:body;color:soft}
}else if extraErr{
Text{text:S.sourceErr+" "+(extra.code??"");style:body;color:"#ef4444";align:center}
}else if curLg!=null&&maxJ!=null{
Row{
gap:6
Button{text:S.prev;width:56;padding:6;color:curJ!=null&&minJ!=null&&curJ>minJ?foreground:muted;onTap:selJ=curJ-1}
Button{text:curJ==null?"…":"${JP}${curJ} · ${count(jMatches)}";weight:1;color:selJ<0?pop:soft;onTap:selJ=-1}
Button{text:S.nextBtn;width:56;padding:6;color:curJ!=null&&maxJ!=null&&curJ<maxJ?foreground:muted;onTap:selJ=curJ+1}
}
if count(jMatches)==0{
Text{text:S.noMatchDay;style:body;color:soft}
}else{
for g in jMatches key g.id{LiveGame{g:g}}
}
}else if count(topAll)==0&&(extraErr||nextErr){
Text{text:S.sourceErr;style:body;color:"#ef4444";align:center}
}else if count(topAll)==0{
Text{text:S.noRecent;style:body;color:soft}
}else{
for g in(topLg=="ALL"?topList:topAll.take(30))key g.id{LiveGame{g:g}}
}
if standings==null{
Text{text:S.standingsLoading;style:small;color:soft}
}else if !(standings.ok??true){
Text{text:S.sourceErr+" "+(standings.code??"");style:small;color:"#ef4444";align:center}
}else if count(topTables)==0{
Text{text:S.noStandings;style:small;color:soft}
}else{
Text{text:showTables?S.stOn:S.stOff;style:label;color:soft;align:center;onTap:showTables=!showTables}
if showTables{
for u in topTables key u.tag+" "+u.group{TableBlock{u:u}}
}
}
}else if view=="EUROPE"{
Rule{}
Text{text:S.euroMatches;style:label;color:pop}
Text{text:euroLabel+liveWarn;style:small;color:soft}
if nextup==null{
Text{text:S.fixturesLoading;style:small;color:soft}
}else if nextErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(euroNext)>0{
Text{text:S.upcomingHdr;style:label;color:pop}
for g in euroNext key g.id{LiveGame{g:g}}
}
if extra==null{
Text{text:S.loading;style:body;color:soft}
}else if extraErr{
Text{text:S.sourceErr+" "+(extra.code??"");style:body;color:"#ef4444";align:center}
}else if euroCurJ!=null&&euroMaxJ!=null{
Row{
gap:6
Button{text:S.prev;width:56;padding:6;color:euroCurJ!=null&&euroMinJ!=null&&euroCurJ>euroMinJ?foreground:muted;onTap:selJ=euroCurJ-1}
Button{text:euroCurJ==null?"…":"${JP}${euroCurJ} · ${count(euroJMatches)}";weight:1;color:selJ<0?pop:soft;onTap:selJ=-1}
Button{text:S.nextBtn;width:56;padding:6;color:euroCurJ!=null&&euroMaxJ!=null&&euroCurJ<euroMaxJ?foreground:muted;onTap:selJ=euroCurJ+1}
}
if count(euroJMatches)==0{
Text{text:S.noMatchDay;style:body;color:soft}
}else{
for g in euroJMatches key g.id{LiveGame{g:g}}
}
}else if count(euroMatches)==0&&(extraErr||nextErr||histErr){
Text{text:S.sourceErr;style:body;color:"#ef4444";align:center}
}else if count(euroMatches)==0{
Text{text:S.noRecent;style:body;color:soft}
}else{
for g in euroMatches.take(30)key g.id{LiveGame{g:g}}
}
if standings==null{
Text{text:S.standingsLoading;style:small;color:soft}
}else if !(standings.ok??true){
Text{text:S.sourceErr+" "+(standings.code??"");style:small;color:"#ef4444";align:center}
}else if count(euroTables)==0{
Text{text:S.noStandings;style:small;color:soft}
}else{
Text{text:showTables?S.stOn:S.stOff;style:label;color:soft;align:center;onTap:showTables=!showTables}
if showTables{
for u in euroTables key u.tag+" "+u.group{TableBlock{u:u}}
}
}
Rule{}
Text{text:S.bracket;style:label;color:pop}
if knock==null{
Text{text:S.bracketLoading;style:small;color:soft}
}else if !(knock.ok??true){
Text{text:S.sourceErr+" "+(knock.code??"");style:small;color:"#ef4444";align:center}
}else if count(knockLg)==0{
Text{text:S.leaguePhase;style:small;color:soft}
}else{
for st in knockRounds key st{
let sm=knockLg.filter(g=>(g.stage??"")==st)
if count(sm)>0{
Text{text:"${get(knockLabels, st, st)} · ${count(sm)}";style:small;color:soft}
for g in sm key g.id{
LiveGame{g:g}
if g.aggH!=null&&g.aggA!=null{
Text{text:S.agg+g.aggH+"–"+g.aggA+(g.aggDone?"":" …");style:label;color:soft;align:center;maxLines:1}
}
}
}
}
}
}else if games==null{
Text{text:S.loading;style:body;color:soft}
}else if gamesErr{
Text{text:S.sourceErr+" "+(games.code??"");style:body;color:"#ef4444";align:center}
}else if team=="ALL"{
for t in myTeams key t.key{
let gm=baseF.filter(g=>(g.squads??[]).any(s=>s==t.abbr))
let tb=myTablesAll.filter(u=>(u.teams??[]).any(tm=>tm.ours==t.abbr))
let gmShown=gm
let exp=!(secClosed.any(a=>a==t.abbr))
if count(gm)>0||count(tb)>0{
Rule{}
Text{text:exp?t.name:"${t.name} (${count(gm)}) ›";style:label;color:pop;onTap:secClosed=secClosed.any(a=>a==t.abbr)?secClosed.filter(a=>a!=t.abbr):(secClosed+[t.abbr]).take(10)}
if exp{
for g in gmShown key g.id{LiveGame{g:g}}
for u in tb key u.tag+" "+u.group{TableBlock{u:u}}
}
}
}
}else{
let one=myTablesAll.filter(u=>(u.teams??[]).any(tm=>tm.ours==team))
if count(baseF)==0&&count(one)==0&&(extraErr||seasonAllErr){
Text{text:S.sourceErr;style:body;color:"#ef4444";align:center}
}else if count(baseF)==0&&count(one)==0{
Text{text:S.noMatchAny;style:body;color:soft}
}else{
let shown1=baseF
for g in shown1 key g.id{LiveGame{g:g}}
for u in one key u.tag+" "+u.group{TableBlock{u:u}}
}
}
}
Button{text:S.close;onTap:close()}
}
}
}
}
