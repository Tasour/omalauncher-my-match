      elif [ "$1" = "fifa.friendly" ]; then printf 'AMI'
      elif [ "$1" = "eng.1" ]; then printf 'ENG'
      elif [ "$1" = "esp.1" ]; then printf 'ESP'
      elif [ "$1" = "ger.1" ]; then printf 'GER'
      elif [ "$1" = "ita.1" ]; then printf 'ITA'
      elif [ "$1" = "ned.1" ]; then printf 'NED'
      elif [ "$1" = "por.1" ]; then printf 'POR'
      elif [ "$1" = "tur.1" ]; then printf 'TUR'
      elif [ "$1" = "bel.1" ]; then printf 'BEL'
      elif [ "$1" = "sco.1" ]; then printf 'SCO'
      elif [ "$1" = "gre.1" ]; then printf 'GRE'
      elif [ "$1" = "sui.1" ]; then printf 'SUI'
      elif [ "$1" = "aut.1" ]; then printf 'AUT'
      elif [ "$1" = "den.1" ]; then printf 'DEN'
      elif [ "$1" = "nor.1" ]; then printf 'NOR'
      elif [ "$1" = "swe.1" ]; then printf 'SWE'
      elif [ "$1" = "rou.1" ]; then printf 'ROU'
      elif [ "$1" = "cze.1" ]; then printf 'CZE'
      elif [ "$1" = "isr.1" ]; then printf 'ISR'
      elif [ "$1" = "cyp.1" ]; then printf 'CYP'
      else printf '%s' "$1"
      fi
    }
    fetch() {
      lg=$1
      d=$2
      tag=$(tagof "$lg")
      curl --proto '=https' --max-redirs 0 --max-filesize 2097152 --connect-timeout 5 --retry 0 -fsm 10 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/$lg/scoreboard?dates=$d" 2>/dev/null | jq -c --arg lg "$lg" --arg tag "$tag" --arg want "$WANT" '($want | split(",") | map(select(. != ""))) as $wl | def T: {abbr: .team.abbreviation, name: (if .team.abbreviation == "LYON" then "Olympique Lyonnais" else .team.shortDisplayName end), score, winner: (.winner // false), logo: (((.team.logo // "") | sub(".*/teamlogos/"; "")) | if test("^(soccer|countries)/500/[a-z0-9]+[.]png$") then gsub("/"; "-") else "" end)}; .events[]? | .competitions[0] as $c | select($c.status.type.state == "in" or $c.status.type.state == "post") | {id: ($lg + ":" + (.id | tostring)), league: $lg, tag: $tag, stage: (.season.slug // ""), at: (.date[0:16] + ":00Z" | fromdateiso8601), state: $c.status.type.state, detail: $c.status.type.shortDetail, squads: ([$c.competitors[] | .team.abbreviation]), teams: [$c.competitors[] | {side: .homeAway} + T], home: ([$c.competitors[] | select(.homeAway == "home")][0] | T), away: ([$c.competitors[] | select(.homeAway == "away")][0] | T)}'
    }
    n=0
    run() {
      fetch "$1" "$2" > "$tmp/$1-$2.jsonl" &
      n=$((n + 1))
      if [ "$n" -ge 3 ]; then wait; n=0; sleep 0.5; fi
    }
    while IFS=$'\t' read -r lg day; do
      [ -n "$lg" ] && [ -n "$day" ] && run "$lg" "$day"
