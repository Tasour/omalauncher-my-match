#!/bin/sh
# Offline curl for the widget tests. Only the ESPN endpoints matter.
out=""
url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -o*) out="${1#-o}"; shift ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
[ -n "${MOCK_LOG:-}" ] && printf '%s\n' "$url" >>"$MOCK_LOG"
[ "${MOCK_MODE:-}" = "offline" ] && exit 7
case "$url" in
  *a.espncdn.com*)
    if [ "${MOCK_LOGO:-0}" = 1 ]; then
      if [ -n "$out" ]; then printf 'png' >"$out"; else printf 'png'; fi
      exit 0
    fi
    exit 1
    ;;
  *site.api.espn.com*)
    case "${MOCK_MODE:-}" in
      429|500|503)
        body="{\"error\":\"http ${MOCK_MODE}\"}"
        if [ -n "$out" ]; then printf '%s' "$body" >"$out"; else printf '%s' "$body"; fi
        exit 22
        ;;
      big)
        # Real curl --max-filesize 2097152 refuses the transfer before it
        # starts (exit 63). Do not hand any oversized body to the widget.
        exit 63
        ;;
    esac
    case "$url" in
      */standings*)
        league=$(printf '%s' "$url" | sed -n 's#.*/soccer/\([^/]*\)/standings.*#\1#p')
        if [ "${MOCK_MODE:-}" = "trunc" ]; then
          body='{"events":['
        elif [ "${MOCK_INVALID:-0}" = 1 ]; then
          body='{"error":"rate limited"}'
        else
          f="${FIXTURES:-}/$league.standings.json"
          if [ -n "${FIXTURES:-}" ] && [ -f "$f" ]; then body=$(cat "$f"); else body='{"children":[]}'; fi
        fi
        ;;
      */teams/*/schedule*)
        league=$(printf '%s' "$url" | sed -n 's#.*/soccer/\([^/]*\)/teams/.*#\1#p')
        id=$(printf '%s' "$url" | sed -n 's#.*/teams/\([^/]*\)/schedule.*#\1#p')
        if [ "${MOCK_MODE:-}" = "trunc" ]; then
          body='{"events":['
        elif [ "${MOCK_INVALID:-0}" = 1 ]; then
          body='{"error":"rate limited"}'
        else
          body=''
          for f in "${FIXTURES:-}/$league.$id.schedule.json" \
                   "${FIXTURES:-}/$league.schedule.json" \
                   "${FIXTURES:-}/schedule.json"; do
            if [ -n "${FIXTURES:-}" ] && [ -f "$f" ]; then body=$(cat "$f"); break; fi
          done
          [ -n "$body" ] || body='{"events":[]}'
        fi
        ;;
      */summary*)
        league=$(printf '%s' "$url" | sed -n 's#.*/soccer/\([^/]*\)/summary.*#\1#p')
        if [ "${MOCK_INVALID:-0}" = 1 ]; then
          body='{"error":"rate limited"}'
        else
          f="${FIXTURES:-}/$league.summary.json"
          [ -n "${FIXTURES:-}" ] && [ ! -f "$f" ] && f="${FIXTURES:-}/summary-h2h.json"
          if [ -n "${FIXTURES:-}" ] && [ -f "$f" ]; then body=$(cat "$f"); else body='{}'; fi
        fi
        ;;
      */teams|*/teams'?'*)
        league=$(printf '%s' "$url" | sed -n 's#.*/soccer/\([^/]*\)/teams.*#\1#p')
        if [ "${MOCK_MODE:-}" = "trunc" ]; then
          body='{"sports":['
        elif [ "${MOCK_INVALID:-0}" = 1 ]; then
          body='{"error":"rate limited"}'
        else
          f="${FIXTURES:-}/$league.teams.json"
          if [ -n "${FIXTURES:-}" ] && [ -f "$f" ]; then body=$(cat "$f"); else body='{"sports":[{"leagues":[{"teams":[]}]}]}'; fi
        fi
        ;;
      *)
        league=$(printf '%s' "$url" | sed -n 's#.*/soccer/\([^/]*\)/scoreboard.*#\1#p')
        if [ "${MOCK_MODE:-}" = "trunc" ]; then
          body='{"events":['
        elif [ "${MOCK_INVALID:-0}" = 1 ]; then
          body='{"error":"rate limited"}'
        else
          f="${FIXTURES:-}/$league.json"
          if [ -n "${FIXTURES:-}" ] && [ -f "$f" ]; then body=$(cat "$f"); else body='{"events":[]}'; fi
        fi
        ;;
    esac
    if [ -n "$out" ]; then printf '%s' "$body" >"$out"; else printf '%s' "$body"; fi
    exit 0
    ;;
  *) exit 1 ;;
esac
